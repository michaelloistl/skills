#!/usr/bin/env python3
"""Strip the footer a Claude Code cloud session's GitHub proxy appends to what it writes.

    scripts/strip-claude-footer <owner/repo> [--since DATE] [--dry-run]

Every issue body, PR body and comment written from a cloud session ends in
`---` and `_Generated by [Claude Code](https://claude.ai/code)_`, whatever the
session's `attribution` setting says. An edit from outside the cloud stays
clean, so this runs on your own machine, with your own `gh` login: it refuses
inside a cloud session, where its edits would get the footer back.

It reads what changed since DATE (default: 7 days ago; ISO 8601, e.g.
2026-11-20): issues and PRs, their comments and PR review comments. Each body
ending in the footer is edited to the text before it. GitHub's "with Claude"
badge stays: it marks who created the item, not its text.

Exit codes: 0 done (or nothing to strip), 1 a failed `gh` call, 2 refused.
"""

import argparse
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timedelta, timezone

FOOTER = re.compile(r"\s*\n-{3,}\s*\n_Generated by \[Claude Code\]\(https://claude\.ai/code\)_\s*\Z")


def strip_footer(body):
    """The body without the cloud footer, or None when it has none."""
    if not isinstance(body, str):
        return None
    m = FOOTER.search(body)
    return body[:m.start()] if m else None


def gh(*args, body=None):
    cmd = ["gh", "api", *args]
    if body is not None:
        cmd += ["--input", "-"]
    out = subprocess.run(cmd, input=json.dumps({"body": body}) if body is not None else None,
                         capture_output=True, text=True)
    if out.returncode != 0:
        raise RuntimeError(f"gh api {' '.join(args[:3])}: {out.stderr.strip() or f'exit {out.returncode}'}")
    return out.stdout


def pages(api, path):
    """Every item of a paginated list endpoint."""
    out = api("--paginate", path, "--jq", ".[]")
    return [json.loads(line) for line in out.splitlines() if line.strip()]


def targets(api, repo, since):
    """(kind, number or id, PATCH path, new body) for each item whose body ends in the footer."""
    found = []
    for i in pages(api, f"repos/{repo}/issues?state=all&since={since}&per_page=100"):
        new = strip_footer(i.get("body"))
        if new is not None:
            kind = "pr" if "pull_request" in i else "issue"
            found.append((kind, i["number"], f"repos/{repo}/issues/{i['number']}", new))
    for c in pages(api, f"repos/{repo}/issues/comments?since={since}&per_page=100"):
        new = strip_footer(c.get("body"))
        if new is not None:
            found.append(("comment", c["id"], f"repos/{repo}/issues/comments/{c['id']}", new))
    for c in pages(api, f"repos/{repo}/pulls/comments?since={since}&per_page=100"):
        new = strip_footer(c.get("body"))
        if new is not None:
            found.append(("review comment", c["id"], f"repos/{repo}/pulls/comments/{c['id']}", new))
    return found


def main(argv=None, api=gh, env=None):
    env = os.environ if env is None else env
    p = argparse.ArgumentParser(description="Strip the Claude Code cloud footer from a repo's issues, PRs and comments.")
    p.add_argument("repo", help="owner/name")
    p.add_argument("--since", help="ISO 8601 date or time; default 7 days ago")
    p.add_argument("--dry-run", action="store_true", help="list what would change, change nothing")
    args = p.parse_args(argv)
    if env.get("CLAUDE_CODE_REMOTE") == "true":
        print("refuse: this is a cloud session, whose GitHub proxy appends the footer to every edit; "
              "run it on your own machine", file=sys.stderr)
        return 2
    if not re.fullmatch(r"[\w.-]+/[\w.-]+", args.repo):
        print(f"refuse: {args.repo!r} is not owner/name", file=sys.stderr)
        return 2
    since = args.since or (datetime.now(timezone.utc) - timedelta(days=7)).strftime("%Y-%m-%dT%H:%M:%SZ")
    try:
        found = targets(api, args.repo, since)
        for kind, ref, path, new in found:
            label = f"#{ref}" if kind in ("issue", "pr") else str(ref)
            if args.dry_run:
                print(f"would strip {kind} {label}")
                continue
            api("-X", "PATCH", path, body=new)
            print(f"stripped {kind} {label}")
    except RuntimeError as e:
        print(e, file=sys.stderr)
        return 1
    if not found:
        print(f"nothing to strip since {since}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
