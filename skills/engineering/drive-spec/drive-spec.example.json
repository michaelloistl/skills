{
  "baseBranch": "main",
  "bootstrap": "yarn install --frozen-lockfile",
  "verify": "yarn typecheck && yarn test",
  "verifyTimeoutMinutes": 60,
  "reviewRounds": 3,
  "parallel": false,
  "maxSlices": 5,
  "worktreeRoot": ".claude/worktrees",
  "agent": ["claude", "-p", "--allowedTools", "Bash", "--verbose", "--output-format", "stream-json",
            "--permission-mode", "acceptEdits", "--permission-prompts", "none"],
  "localOnly": {
    "label": "needs:desktop",
    "proof": "docs/agents/desktop-proof.md"
  }
}
