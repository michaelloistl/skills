#!/usr/bin/env python3
"""drive-spec: the deterministic half of a drive-spec run. See README.md."""

import argparse
import fcntl
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

REF = re.compile(r"#(\d+)\b")
HEADING = re.compile(r"^#{1,2}\s+(.*?)\s*#*\s*$")
MARKER = "<!-- implement-spec -->"
PR_FIELDS = ".[] | {number, head: .head.ref, url: .html_url, merged_at}"
VERIFY_LOCK = "/tmp/drive-spec-verify.lock"
POLL_SECONDS = float(os.environ.get("DRIVE_SPEC_POLL_SECONDS", 3))
SPEC_MOVES = 5
REFUSE, CONFLICT, RED, INBOX = 2, 3, 4, 5
LABEL_COLORS = {"agent:in-progress": "0E8A16", "agent:blocked": "B60205"}


class Failed(Exception):
    def __init__(self, message, code=1):
        super().__init__(message)
        self.code = code


def sh(cmd):
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as e:
        raise Failed(f"{cmd[0]}: {e}")
    if out.returncode != 0:
        raise Failed(f"{' '.join(cmd[:3])}: {out.stderr.strip() or f'exit {out.returncode}'}")
    return out.stdout


def json_lines(text):
    return [json.loads(line) for line in text.splitlines() if line.strip()]


def repo_slug(url):
    parts = re.split(r"[/:]", re.sub(r"(\.git)?/*$", "", url.strip()))
    return f"{parts[-2]}/{parts[-1]}"


def sections(body):
    """Body text under each `#`/`##` heading, keyed by lowercased heading."""
    out, current = {}, None
    for line in (body or "").replace("\r\n", "\n").split("\n"):
        m = HEADING.match(line)
        if m:
            current = m.group(1).lower()
            out.setdefault(current, "")
        elif current is not None:
            out[current] += line + "\n"
    return out


def parent_of(body):
    m = REF.search(sections(body).get("parent", ""))
    return int(m.group(1)) if m else None


def blockers_of(body):
    return sorted({int(n) for n in REF.findall(sections(body).get("blocked by", ""))})


def cycle_members(edges, nodes):
    """Slices on a cycle among `nodes` (Tarjan), excluding those only downstream of one."""
    index, low, stack, on, found, counter = {}, {}, [], set(), [], [0]

    def visit(v):
        index[v] = low[v] = counter[0]
        counter[0] += 1
        stack.append(v)
        on.add(v)
        for w in edges[v]:
            if w not in nodes:
                continue
            if w not in index:
                visit(w)
                low[v] = min(low[v], low[w])
            elif w in on:
                low[v] = min(low[v], index[w])
        if low[v] == index[v]:
            comp = []
            while True:
                w = stack.pop()
                on.discard(w)
                comp.append(w)
                if w == v:
                    break
            if len(comp) > 1 or v in edges[v]:
                found.extend(comp)

    for v in sorted(nodes):
        if v not in index:
            visit(v)
    return sorted(found)


def build_plan(spec, issues, heads, open_prs, sub_issues=(), held_label=None, cloud=False):
    """The run's plan from tracker and branch facts alone.

    spec: the spec issue; issues: every issue whose body may reference it;
    heads: branch names on origin; open_prs: head refs of open PRs into the spec branch;
    sub_issues: native sub-issue numbers of the spec.
    """
    n = spec["number"]
    plan = {"spec": n, "title": spec.get("title", ""), "refuse": None}

    if spec.get("pull_request") is not None:
        plan["refuse"] = f"#{n} is a pull request, not a spec issue"
        return plan
    own_parent = parent_of(spec.get("body"))
    if own_parent is not None:
        plan["refuse"] = f"#{n} has a ## Parent of its own (#{own_parent}): it is a slice, not a spec"
        return plan

    slices = {i["number"]: i for i in issues
              if i.get("pull_request") is None and i["number"] != n and parent_of(i.get("body")) == n}
    plan["invisible"] = sorted(set(sub_issues) - set(slices))
    if not slices:
        plan["refuse"] = f"#{n} has no tracer-bullets: no issue names it first under ## Parent"
        return plan

    edges, external = {}, {}
    for m, i in slices.items():
        refs = blockers_of(i.get("body"))
        edges[m] = [b for b in refs if b in slices]
        external[m] = [b for b in refs if b not in slices]

    order, taken = [], set()
    while True:
        ready = [m for m in slices if m not in taken and all(b in taken for b in edges[m])]
        if not ready:
            break
        m = min(ready)
        order.append(m)
        taken.add(m)
    left = set(slices) - taken
    if left:
        cycle = cycle_members(edges, left)
        plan["refuse"] = "blockers form a cycle: " + ", ".join(f"#{m}" for m in cycle)
        plan["cycle"] = cycle
        return plan

    specs = [h for h in heads if h.startswith(f"agent/local-spec-{n}-")]
    if len(specs) > 1:
        raise Failed(f"several spec branches on origin for #{n}: {', '.join(specs)}")
    plan["spec_branch"] = specs[0] if specs else None

    out = []
    for m in order:
        i = slices[m]
        prefix = f"agent/issue-{m}-"
        pr = next((p for p in open_prs if p["head"].startswith(prefix)), None)
        branch = next((h for h in heads if h.startswith(prefix)), None)
        labels = i.get("labels", [])
        if i.get("state") == "closed":
            state = "closed"
        elif cloud and held_label and held_label in labels:
            state = "held"
        elif pr:
            state, branch = "open-pr", pr["head"]
        elif branch:
            state = "in-flight"
        else:
            state = "todo"
        out.append({
            "number": m,
            "title": i.get("title", ""),
            "state": state,
            "blockers": edges[m],
            "external_blockers": external[m],
            "labels": labels,
            "branch": branch if state != "closed" else None,
            "pr": pr["number"] if pr and state == "open-pr" else None,
        })
    plan["slices"] = out
    return plan


def render(plan):
    lines = [f"spec #{plan['spec']} {plan['title']}"]
    if plan["refuse"]:
        lines.append(f"refuse: {plan['refuse']}")
        return "\n".join(lines)
    lines.append(f"spec branch: {plan['spec_branch'] or 'none on origin'}")
    lines.append("order:")
    width = max(len(f"#{s['number']}") for s in plan["slices"])
    for s in plan["slices"]:
        state = f"open-pr #{s['pr']}" if s["pr"] else s["state"]
        after = f"  after {', '.join(f'#{b}' for b in s['blockers'])}" if s["blockers"] else ""
        num = f"#{s['number']}"
        lines.append(f"  {num:<{width}}  {state:<12} {s['title']}{after}")
    ext = [f"#{b} (for #{s['number']})" for s in plan["slices"] for b in s["external_blockers"]]
    if ext:
        lines.append("outside the spec, ignored: " + ", ".join(ext))
    if plan["invisible"]:
        lines.append("invisible (sub-issue without ## Parent, not built): "
                     + ", ".join(f"#{m}" for m in plan["invisible"]))
    return "\n".join(lines)




def load_config(root):
    try:
        return json.loads((Path(root) / ".claude" / "drive-spec.json").read_text())
    except FileNotFoundError:
        return {}
    except ValueError as e:
        raise Failed(f".claude/drive-spec.json: {e}")


def git(cwd, *args):
    return sh(["git", "-C", str(cwd), *args]).strip()


def gh(*args):
    return sh(["gh", "api", *args])


def dirty(wt):
    return git(wt, "status", "--porcelain") != ""


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def stamp():
    return datetime.now(timezone.utc).isoformat()


class Run:
    """Where a spec's run lives: repo, worktree root, notes, config."""

    def __init__(self, spec):
        self.spec = spec
        self.common = Path(sh(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"]).strip())
        self.repo_dir = self.common.parent
        self.config = load_config(self.repo_dir)
        self.repo = repo_slug(git(self.repo_dir, "remote", "get-url", "origin"))
        self.root = self.repo_dir / (self.config.get("worktreeRoot") or ".claude/worktrees")
        self.notes = self.common / "drive-spec" / f"spec-{spec}"
        self.cloud = os.environ.get("CLAUDE_CODE_REMOTE") == "true"

    def heads(self, pattern="agent/*"):
        out = git(self.repo_dir, "ls-remote", "--heads", "origin", pattern)
        return [line.split("refs/heads/", 1)[1] for line in out.splitlines() if "refs/heads/" in line]

    def spec_branch(self):
        found = self.heads(f"agent/local-spec-{self.spec}-*")
        if len(found) != 1:
            raise Failed(f"expected one spec branch agent/local-spec-{self.spec}-* on origin, found "
                         f"{', '.join(found) or 'none'}", REFUSE)
        return found[0]

    def prs(self, state, base, head=None):
        query = f"state={state}&base={base}&per_page=100"
        if head:
            query += f"&head={self.repo.split('/')[0]}:{head}"
        return json_lines(gh("--paginate", f"repos/{self.repo}/pulls?{query}", "--jq", PR_FIELDS))

    def base(self):
        try:
            base = json.loads((self.common / "drive-spec" / "status" / f"spec-{self.spec}.json").read_text()).get("base")
        except (OSError, ValueError):
            base = None
        return base or self.config.get("baseBranch") or gh(f"repos/{self.repo}", "--jq", ".default_branch").strip()

    def status(self, **fields):
        script = Path(__file__).resolve().with_name("status.sh")
        subprocess.run([str(script), str(self.spec), *(f"{k}={v}" for k, v in fields.items())],
                       cwd=self.repo_dir, timeout=60)


def fetch(run):
    spec, repo = run.spec, run.repo
    spec_issue = json.loads(gh(f"repos/{repo}/issues/{spec}", "--jq", "{number,title,body,state,pull_request}"))
    issues = [i for i in json_lines(gh(
        "--paginate", f"repos/{repo}/issues?state=all&per_page=100",
        "--jq", ".[] | {number,title,body,state,pull_request,labels: [.labels[].name]}"))
        if f"#{spec}" in (i.get("body") or "")]
    heads = run.heads()
    try:
        sub_issues = [i["number"] for i in json_lines(gh(
            "--paginate", f"repos/{repo}/issues/{spec}/sub_issues", "--jq", ".[] | {number}"))]
    except Failed:
        sub_issues = []
    spec_branch = next((h for h in heads if h.startswith(f"agent/local-spec-{spec}-")), None)
    open_prs = run.prs("open", spec_branch) if spec_branch else []
    return spec_issue, issues, heads, open_prs, sub_issues


def make_plan(run):
    label = (run.config.get("localOnly") or {}).get("label")
    return build_plan(*fetch(run), held_label=label, cloud=run.cloud)


def cmd_plan(spec, as_json):
    plan = make_plan(Run(spec))
    print(json.dumps(plan, indent=2) if as_json else render(plan))
    return REFUSE if plan["refuse"] else 0


def progress_summary(plan):
    landed = sum(x["state"] == "closed" for x in plan["slices"])
    building = [f"#{x['number']}" for x in plan["slices"]
                if x["state"] != "closed" and "agent:in-progress" in x["labels"]]
    return f"landed {landed}/{len(plan['slices'])}" + (f"; building {', '.join(building)}" if building else "")


def inbox(run):
    """Print and archive the dispatcher's unread notes. True when there were any: act on them first."""
    script = Path(__file__).resolve().with_name("status.sh")
    notes = subprocess.run([str(script), str(run.spec), "--inbox"], cwd=run.repo_dir, capture_output=True,
                           text=True, timeout=60).stdout
    if not notes.strip():
        return False
    print(notes.rstrip())
    print(f"inbox: act on these notes at this boundary (STATUS.md, Inbox), then run this command again")
    return True


def ensure_label(run, name):
    try:
        gh(f"repos/{run.repo}/labels/{name.replace(':', '%3A')}", "--silent")
    except Failed:
        gh(f"repos/{run.repo}/labels", "-f", f"name={name}", "-f", f"color={LABEL_COLORS[name]}", "--silent")


def add_label(run, m, name):
    ensure_label(run, name)
    gh(f"repos/{run.repo}/issues/{m}/labels", "-f", f"labels[]={name}", "--silent")


def remove_label(run, m, name):
    try:
        gh("-X", "DELETE", f"repos/{run.repo}/issues/{m}/labels/{name.replace(':', '%3A')}", "--silent")
    except Failed:
        pass


# verify

def pinned_gate(run):
    try:
        return (run.notes / "gate").read_text().strip() or None
    except FileNotFoundError:
        return None


def cmd_gate(spec, command):
    run = Run(spec)
    if command:
        old = pinned_gate(run)
        run.notes.mkdir(parents=True, exist_ok=True)
        (run.notes / "gate").write_text(command + "\n")
        (run.notes / "run.json").write_text(json.dumps({"started_at": stamp(), "gate": command}))
        print(f"gate pinned: {command}" + (f" (was: {old})" if old and old != command else ""))
        return 0
    gate = pinned_gate(run) or run.config.get("verify")
    if not gate:
        raise Failed("no verify gate: pin one with `drive-spec gate <spec> '<command>'`", REFUSE)
    print(gate)
    return 0


def record(run, sha):
    try:
        return json.loads((run.notes / "verified" / f"{sha}.json").read_text())
    except (OSError, ValueError):
        return {}


def verify(run, wt):
    """Run the gate on the worktree's HEAD and record the verdict against that commit. True when green."""
    wt = Path(wt).resolve()
    if dirty(wt):
        raise Failed(f"{wt} has uncommitted changes: commit them first, the verdict is recorded against a commit",
                     REFUSE)
    head = git(wt, "rev-parse", "HEAD")
    if record(run, head).get("exit") == 0:
        print(f"green {head[:12]} (already verified)")
        return True
    gate = pinned_gate(run) or run.config.get("verify")
    if not gate:
        raise Failed("no verify gate: pin one with `drive-spec gate <spec> '<command>'`", REFUSE)
    cmd = ["flock", VERIFY_LOCK, "sh", "-c", gate] if shutil.which("flock") else ["sh", "-c", gate]
    logs = run.notes / "logs"
    logs.mkdir(parents=True, exist_ok=True)
    log = logs / f"{head}.log"
    started = now()
    with open(log, "w") as out:
        code = subprocess.run(cmd, cwd=wt, stdout=out, stderr=subprocess.STDOUT).returncode
    if git(wt, "rev-parse", "HEAD") != head:
        raise Failed(f"HEAD moved while the gate ran on {head[:12]}: nothing recorded")
    (run.notes / "verified").mkdir(exist_ok=True)
    (run.notes / "verified" / f"{head}.json").write_text(json.dumps(
        {"sha": head, "gate": gate, "exit": code, "started_at": started, "finished_at": now(), "log": str(log)}))
    if code == 0:
        print(f"green {head[:12]}")
        return True
    print("".join(log.read_text().splitlines(keepends=True)[-40:]), end="")
    print(f"red {head[:12]}: exit {code}; log {log}")
    return False


def cmd_verify(spec, wt):
    return 0 if verify(Run(spec), wt) else RED


# integrate

def slice_worktree(run, m):
    wt = run.root / f"issue-{m}"
    if not wt.is_dir():
        raise Failed(f"no slice worktree at {wt}", REFUSE)
    branch = git(wt, "branch", "--show-current")
    if not branch.startswith(f"agent/issue-{m}-"):
        raise Failed(f"{wt} is on {branch or 'a detached HEAD'}, not agent/issue-{m}-*", REFUSE)
    return wt, branch


def bodied_commits(wt, since):
    out = git(wt, "log", "--no-merges", "--format=%h%x01%s%x01%b%x02", f"{since}..HEAD")
    commits = [c.strip().split("\x01") for c in out.split("\x02") if c.strip()]
    return [c[:2] for c in commits if c[2].strip()]


def merge_pr(run, pr, head):
    """Merge the PR at exactly `head`. True when merged, False when GitHub says it cannot merge."""
    for _ in range(40):
        state = json.loads(gh(f"repos/{run.repo}/pulls/{pr}", "--jq", "{mergeable, merged_at, head: .head.sha}"))
        if state["merged_at"]:
            return state["head"] == head
        if state["head"] == head and state["mergeable"] is not None:
            break
        time.sleep(POLL_SECONDS)
    else:
        raise Failed(f"GitHub never reported #{pr} mergeable at {head[:12]}")
    if not state["mergeable"]:
        return False
    gh("-X", "PUT", f"repos/{run.repo}/pulls/{pr}/merge", "-f", "merge_method=merge", "-f", f"sha={head}", "--silent")
    merged_at = gh(f"repos/{run.repo}/pulls/{pr}", "--jq", ".merged_at").strip()
    if merged_at in ("", "null"):
        raise Failed(f"#{pr} merge is queued or blocked: not landed")
    return True


def cmd_integrate(spec, m, deviations):
    run = Run(spec)
    wt, branch = slice_worktree(run, m)
    if Path(git(wt, "rev-parse", "--absolute-git-dir"), "MERGE_HEAD").exists():
        raise Failed(f"a merge is in progress in {wt}: commit or abort it first", REFUSE)
    if dirty(wt):
        raise Failed(f"{wt} has uncommitted changes: the implementer commits everything first", REFUSE)
    run.notes.mkdir(parents=True, exist_ok=True)
    lock = open(run.notes / "integrate.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise Failed("another integration into the spec branch is running: one slice at a time", REFUSE)

    if inbox(run):
        return INBOX
    spec_branch = run.spec_branch()
    git(wt, "fetch", "--quiet", "origin")
    bad = bodied_commits(wt, f"origin/{spec_branch}")
    if bad:
        raise Failed("commits carry a body or trailer; reword each to its subject line only: "
                     + "; ".join(f"{sha} {subject}" for sha, subject in bad), REFUSE)

    open_prs = run.prs("open", spec_branch, branch)
    if open_prs:
        pr = open_prs[0]["number"]
    else:
        if not deviations:
            raise Failed("opening the slice PR needs --deviations: the implementer's list, or `none`", REFUSE)
        text = sys.stdin.read() if deviations == "-" else deviations
        text = re.sub(r"^\s*Deviations:\s*", "", text.strip())
        title = gh(f"repos/{run.repo}/issues/{m}", "--jq", ".title").strip()
        git(wt, "push", "--quiet", "-u", "origin", branch)
        pr = json.loads(gh(f"repos/{run.repo}/pulls", "-f", f"base={spec_branch}", "-f", f"head={branch}",
                           "-f", f"title={title}",
                           "-f", f"body=Slice of #{spec}. Ref #{m}.\n\nDeviations:\n{text}",
                           "--jq", "{number}"))["number"]
        print(f"opened #{pr}")

    for _ in range(SPEC_MOVES):
        git(wt, "fetch", "--quiet", "origin")
        target = git(wt, "rev-parse", f"origin/{spec_branch}")
        try:
            git(wt, "merge", "--quiet", "--no-edit", target)
        except Failed:
            files = git(wt, "diff", "--name-only", "--diff-filter=U").split()
            subprocess.run(["git", "-C", str(wt), "merge", "--abort"], capture_output=True)
            if not files:
                raise
            print(f"conflict merging {spec_branch} {target[:12]} into #{m}: {', '.join(files)}")
            print(f"next: a merger subagent runs `git merge {target}` in {wt}, resolves every conflict and "
                  f"commits; then `drive-spec integrate {spec} {m}` again")
            return CONFLICT
        if not verify(run, wt):
            print(f"#{m} is red on the spec branch: halt the run; worktree kept at {wt}")
            return RED
        head = git(wt, "rev-parse", "HEAD")
        git(wt, "push", "--quiet", "origin", branch)
        git(wt, "fetch", "--quiet", "origin")
        if git(wt, "rev-parse", f"origin/{spec_branch}") != target:
            continue
        if merge_pr(run, pr, head):
            print(f"merged #{pr}: #{m} into {spec_branch} at {head[:12]}; next: drive-spec land {spec} {m}")
            return 0
        if git(wt, "rev-parse", f"origin/{spec_branch}") == target:
            raise Failed(f"GitHub reports #{pr} not mergeable, and the spec branch has not moved")
    raise Failed(f"the spec branch moved {SPEC_MOVES} times during integration: run integrate again")


# land

def progress_body(plan, base, spec_pr):
    lines = [MARKER, f"**Building `{plan['spec_branch']}` → `{base}`**", ""]
    for s in plan["slices"]:
        done = s["state"] == "closed"
        mark = (" ← held for a local run" if s["state"] == "held"
                else " ← building" if not done and "agent:in-progress" in s["labels"] else "")
        lines.append(f"- [{'x' if done else ' '}] #{s['number']} {s['title']}{mark}")
    if spec_pr:
        lines += ["", f"Spec PR: #{spec_pr['number']}"]
    lines += ["", f"_Updated {now()} from {socket.gethostname()}._"]
    return "\n".join(lines)


def post_progress(run, plan, base, spec_pr):
    ids = [c["id"] for c in json_lines(gh("--paginate", f"repos/{run.repo}/issues/{run.spec}/comments",
                                          "--jq", ".[] | {id, body}"))
           if (c.get("body") or "").startswith(MARKER)]
    body = progress_body(plan, base, spec_pr)
    if ids:
        gh("-X", "PATCH", f"repos/{run.repo}/issues/comments/{ids[0]}", "-f", f"body={body}", "--silent")
    else:
        gh(f"repos/{run.repo}/issues/{run.spec}/comments", "-f", f"body={body}", "--silent")


def spec_pr_of(run, base, branch):
    found = run.prs("open", base, branch)
    return found[0] if found else None


def checked_plan(run):
    plan = make_plan(run)
    if plan["refuse"]:
        raise Failed(f"refuse: {plan['refuse']}", REFUSE)
    if not plan["spec_branch"]:
        raise Failed(f"no spec branch agent/local-spec-{run.spec}-* on origin", REFUSE)
    return plan


def cmd_progress(spec):
    run = Run(spec)
    plan = checked_plan(run)
    base = run.base()
    post_progress(run, plan, base, spec_pr_of(run, base, plan["spec_branch"]))
    print(f"progress comment refreshed on #{spec}")
    return 0


def cmd_land(spec, m):
    run = Run(spec)
    plan = checked_plan(run)
    s = next((s for s in plan["slices"] if s["number"] == m), None)
    if not s:
        raise Failed(f"#{m} is not a slice of #{spec}", REFUSE)
    spec_branch = plan["spec_branch"]
    prefix = f"agent/issue-{m}-"
    merged = [p for p in run.prs("closed", spec_branch) if p["head"].startswith(prefix) and p["merged_at"]]
    if not merged:
        raise Failed(f"#{m} has no merged PR into {spec_branch}: integrate it first", REFUSE)
    pr = merged[0]

    spec_wt = run.root / f"spec-{spec}"
    if spec_wt.is_dir():
        git(spec_wt, "pull", "--quiet", "--ff-only")
    run.notes.mkdir(parents=True, exist_ok=True)
    if s["state"] != "closed":
        gh(f"repos/{run.repo}/issues/{m}/comments", "-f",
           f"body=Landed in #{pr['number']} on `{spec_branch}`.", "--silent")
        gh("-X", "PATCH", f"repos/{run.repo}/issues/{m}", "-f", "state=closed", "-f", "state_reason=completed",
           "--silent")
        s["state"] = "closed"
    if "agent:in-progress" in s["labels"]:
        remove_label(run, m, "agent:in-progress")
        s["labels"].remove("agent:in-progress")

    wt = run.root / f"issue-{m}"
    if wt.is_dir():
        git(run.repo_dir, "worktree", "remove", "--force", str(wt))
    git(run.repo_dir, "worktree", "prune")
    for b in git(run.repo_dir, "branch", "--list", f"{prefix}*", "--format=%(refname:short)").split():
        git(run.repo_dir, "branch", "-D", b)
    if not run.cloud:
        for b in run.heads(f"{prefix}*"):
            git(run.repo_dir, "push", "--quiet", "origin", "--delete", b)

    base = run.base()
    spec_pr = spec_pr_of(run, base, spec_branch)
    if not spec_pr:
        listing = "\n".join(f"- #{x['number']} {x['title']}" for x in plan["slices"])
        spec_pr = json.loads(gh(f"repos/{run.repo}/pulls", "-F", "draft=true", "-f", f"base={base}",
                                "-f", f"head={spec_branch}", "-f", f"title={plan['title']}",
                                "-f", f"body=Ref #{spec}\n\nSlices, in build order:\n{listing}",
                                "--jq", "{number, url: .html_url}"))
        print(f"opened draft spec PR {spec_pr['url']}")
    post_progress(run, plan, base, spec_pr)

    with open(run.notes / "landed.jsonl", "a") as f:
        f.write(json.dumps({"slice": m, "pr": pr["number"], "at": stamp()}) + "\n")
    summary = progress_summary(plan)
    run.status(step="build", state="running", summary=summary, pr_url=spec_pr["url"], branch=spec_branch,
               next="integrate the next completed slice, or pick from the frontier")
    print(f"landed #{m} via #{pr['number']}; {summary}")
    return 0


# frontier and start

def landed_this_run(run):
    try:
        started = json.loads((run.notes / "run.json").read_text())["started_at"]
    except (OSError, ValueError, KeyError):
        raise Failed("no run start: pin the gate at step 1 (`drive-spec gate <spec> '<verify>'`), "
                     "so maxSlices counts only this run's landings", REFUSE)
    try:
        rows = [json.loads(line) for line in (run.notes / "landed.jsonl").read_text().splitlines() if line.strip()]
    except OSError:
        rows = []
    return len({r["slice"] for r in rows if r["at"] >= started})


def pick(plan, running=(), parallel=True, max_slices=None, landed=0, local_label=None):
    """What to do next from the plan alone: picks with their action, or why the run stops."""
    by = {s["number"]: s for s in plan["slices"]}
    open_ = [s for s in plan["slices"] if s["state"] != "closed"]
    out = {"picks": [], "running": [], "stop": None, "blocked": [], "held": [], "landed": landed}
    if not open_:
        out["stop"] = "done"
        return out
    out["blocked"] = [s["number"] for s in open_ if "agent:blocked" in s["labels"]]
    if out["blocked"]:
        out["stop"] = "blocked"
        return out
    out["running"] = running = sorted(m for m in set(running) if m in by and by[m]["state"] != "closed")
    out["held"] = [s["number"] for s in open_ if s["state"] == "held"]

    def local(s):
        return bool(local_label) and local_label in s["labels"]

    ready = sorted((s for s in open_ if s["state"] != "held" and s["number"] not in running
                    and all(by[b]["state"] == "closed" for b in s["blockers"])), key=lambda s: s["number"])
    room = None if max_slices is None else max(0, max_slices - landed - len(running))
    local_busy = any(local(by[m]) for m in running)
    if not parallel and running:
        ready = []
    for s in ready:
        if room is not None and len(out["picks"]) >= room:
            break
        if local(s):
            if local_busy:
                continue
            local_busy = True
        action = {"todo": "build", "in-flight": "continue", "open-pr": "integrate"}[s["state"]]
        out["picks"].append({"number": s["number"], "title": s["title"], "action": action,
                             "branch": s["branch"], "pr": s["pr"]})
        if not parallel:
            break
    if not out["picks"] and not running:
        out["stop"] = "ceiling" if max_slices is not None and landed >= max_slices else "held"
    return out


def render_picks(f):
    lines = []
    for p in f["picks"]:
        where = f" (PR #{p['pr']})" if p["pr"] else f" ({p['branch']})" if p["branch"] else ""
        lines.append(f"{p['action']} #{p['number']} {p['title']}{where}")
    lines += [f"running #{m}" for m in f["running"]]
    if f["stop"] == "ceiling":
        lines.append(f"stop: ceiling, {f['landed']} landed this run")
    elif f["stop"] == "held":
        lines.append("stop: held, only held slices and those they block remain: "
                     + ", ".join(f"#{m}" for m in f["held"]))
    elif f["stop"]:
        lines.append(f"stop: {f['stop']}")
    elif not f["picks"]:
        lines.append("wait: for a running implementer to finish")
    return "\n".join(lines)


def cmd_frontier(spec, running, sequential, max_slices, as_json):
    run = Run(spec)
    if inbox(run):
        return INBOX
    plan = checked_plan(run)
    parallel = not sequential and run.config.get("parallel", True) is not False
    if max_slices is None:
        max_slices = run.config.get("maxSlices")
    f = pick(plan, running, parallel, max_slices, landed_this_run(run) if max_slices is not None else 0,
             (run.config.get("localOnly") or {}).get("label"))
    if f["stop"] == "blocked":
        raise Failed(", ".join(f"#{m}" for m in f["blocked"]) + " carries agent:blocked: the operator removes it "
                     "after fixing, and only then does the run go on", REFUSE)
    print(json.dumps(f, indent=2) if as_json else render_picks(f))
    return 0


def slug_of(title):
    return re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:40].rstrip("-")


def ensure_excluded(run):
    try:
        rel = run.root.relative_to(run.repo_dir).as_posix() + "/"
    except ValueError:
        return
    exclude = run.common / "info" / "exclude"
    lines = exclude.read_text().splitlines() if exclude.exists() else []
    if rel not in lines:
        exclude.parent.mkdir(exist_ok=True)
        with open(exclude, "a") as f:
            f.write(rel + "\n")


def brief(run, m, wt, base, continuing, local_only):
    text = Path(__file__).resolve().with_name("IMPLEMENTER.md").read_text()
    body = text.split("```markdown\n", 1)[1].rsplit("\n```", 1)[0]
    local = run.config.get("localOnly") or {}
    body = re.sub(r'<If continuing: "(.*?)">', lambda x: x.group(1) if continuing else "", body)
    body = re.sub(r'<If localOnly: "(.*?)">', lambda x: x.group(1) if local_only else "", body)
    for key, value in {"<path>": wt, "<m>": m, "<repo>": run.repo, "<spec>": run.spec, "<base>": f"origin/{base}",
                       "<notes>": run.notes, "<skill dir>": Path(__file__).resolve().parent,
                       "<label>": local.get("label", ""), "<proof>": local.get("proof", "")}.items():
        body = body.replace(key, str(value))
    body = re.sub(r" +\n", "\n", body).strip()
    left = re.findall(r"<(?:If [A-Za-z]+:[^>]*|[a-z][a-z ]*)>", body)
    if left:
        raise Failed(f"IMPLEMENTER.md has placeholders start does not fill: {', '.join(left)}")
    return body


def cmd_start(spec, m):
    run = Run(spec)
    plan = checked_plan(run)
    by = {s["number"]: s for s in plan["slices"]}
    s = by.get(m)
    if not s:
        raise Failed(f"#{m} is not a slice of #{spec}", REFUSE)
    if s["state"] == "closed":
        raise Failed(f"#{m} is closed", REFUSE)
    if s["state"] == "held":
        raise Failed(f"#{m} is held: only a local session builds it", REFUSE)
    if "agent:blocked" in s["labels"]:
        raise Failed(f"#{m} carries agent:blocked: the operator removes it after fixing", REFUSE)
    waiting = [f"#{b}" for b in s["blockers"] if by[b]["state"] != "closed"]
    if waiting:
        raise Failed(f"#{m} is not on the frontier: blocked by {', '.join(waiting)}", REFUSE)

    ensure_excluded(run)
    wt = run.root / f"issue-{m}"
    prefix = f"agent/issue-{m}-"
    created = False
    if wt.is_dir():
        branch = git(wt, "branch", "--show-current")
        if not branch.startswith(prefix):
            raise Failed(f"{wt} is on {branch or 'a detached HEAD'}, not {prefix}*", REFUSE)
    else:
        git(run.repo_dir, "fetch", "--quiet", "--prune", "origin")
        local = git(run.repo_dir, "branch", "--list", f"{prefix}*", "--format=%(refname:short)").split()
        remote = run.heads(f"{prefix}*")
        if local:
            branch = local[0]
            git(run.repo_dir, "worktree", "add", "-q", str(wt), branch)
        elif remote:
            branch = remote[0]
            git(run.repo_dir, "worktree", "add", "-q", str(wt), "-b", branch, f"origin/{branch}")
        else:
            branch = prefix + slug_of(s["title"])
            spec_wt = run.root / f"spec-{spec}"
            if spec_wt.is_dir():
                git(spec_wt, "pull", "--quiet", "--ff-only")
                start = git(spec_wt, "rev-parse", "HEAD")
            else:
                start = f"origin/{plan['spec_branch']}"
            git(run.repo_dir, "worktree", "add", "-q", str(wt), "-b", branch, start)
        created = True
    bootstrap = run.config.get("bootstrap")
    if created and bootstrap:
        code = subprocess.run(["sh", "-c", bootstrap], cwd=wt).returncode
        if code != 0:
            raise Failed(f"bootstrap exited {code} in {wt}")
    if "agent:in-progress" not in s["labels"]:
        add_label(run, m, "agent:in-progress")
        s["labels"].append("agent:in-progress")
    run.status(step="build", state="running", summary=progress_summary(plan), branch=plan["spec_branch"],
               next=f"integrate #{m}" if s["state"] == "open-pr" else f"implementer builds #{m}")
    print(f"worktree {wt} on {branch}")
    if s["state"] == "open-pr":
        print(f"#{m} already has PR #{s['pr']}: drive-spec integrate {spec} {m}")
        return 0
    base = run.base()
    continuing = git(wt, "rev-list", "--count", f"origin/{plan['spec_branch']}..HEAD") != "0"
    local_label = (run.config.get("localOnly") or {}).get("label")
    print("brief:\n")
    print(brief(run, m, wt, base, continuing, bool(local_label) and local_label in s["labels"]))
    return 0


# halt and finish

OUTCOMES = {"done": ("done", "review-pr"), "halted": ("halted", "build"), "conflicts": ("halted", "explore"),
            "ceiling": ("paused", "build"), "held": ("paused", "build"), "refused": ("halted", "guard")}


def finish(run, outcome, why=None, slice_=None, step=None, resume=None, left=None):
    spec = run.spec
    plan = make_plan(run)
    resume = resume or f"/drive-spec {spec}"
    extra = ""
    spec_pr = None
    if outcome == "refused":
        if not plan["refuse"]:
            raise Failed(f"`drive-spec plan {spec}` does not refuse the spec", REFUSE)
        first = f"drive-spec refused #{spec}: {plan['refuse']}."
    else:
        if plan["refuse"]:
            raise Failed(f"the plan refuses #{spec}: finish it as `refused`", REFUSE)
        slices = plan["slices"]
        landed = sum(s["state"] == "closed" for s in slices)
        if outcome == "done":
            open_ = [f"#{s['number']}" for s in slices if s["state"] != "closed"]
            if open_:
                raise Failed(f"not done: {', '.join(open_)} still open", REFUSE)
            spec_pr = spec_pr_of(run, run.base(), plan["spec_branch"]) if plan["spec_branch"] else None
            if not spec_pr:
                raise Failed("not done: no open spec PR", REFUSE)
            review = "review left findings open" if left else "review clean"
            first = f"drive-spec done: all {len(slices)} slices landed, {review}. Spec PR #{spec_pr['number']}."
            if left:
                extra = "Left from review:\n" + left.strip()
        elif outcome == "halted":
            if not why:
                raise Failed("a halt needs --why", REFUSE)
            first = f"drive-spec halted on #{slice_}: {why}." if slice_ else f"drive-spec halted: {why}."
        elif outcome == "conflicts":
            try:
                extra = (run.notes / "conflicts.md").read_text().strip()
            except FileNotFoundError:
                extra = ""
            if not extra:
                raise Failed(f"no conflicts recorded in {run.notes / 'conflicts.md'}", REFUSE)
            first = "drive-spec halted before building: the spec and its slices disagree."
        elif outcome == "ceiling":
            first = f"drive-spec paused at maxSlices: {landed} of {len(slices)} slices landed."
        elif outcome == "held":
            held = [f"#{s['number']}" for s in slices if s["state"] == "held"]
            if not held:
                raise Failed("no held slices", REFUSE)
            first = f"drive-spec paused: only held slices remain ({', '.join(held)}). Resume in a local session."
    body = first + ("" if outcome == "done" else f"\n`{resume}`") + (f"\n\n{extra}" if extra else "")
    gh(f"repos/{run.repo}/issues/{spec}/comments", "-f", f"body={body}", "--silent")
    known = {}
    if outcome != "refused" and plan["spec_branch"]:
        base = run.base()
        spec_pr = spec_pr or spec_pr_of(run, base, plan["spec_branch"])
        post_progress(run, plan, base, spec_pr)
        known = {"branch": plan["spec_branch"], **({"pr_url": spec_pr["url"]} if spec_pr else {})}
    state, default_step = OUTCOMES[outcome]
    run.status(step=step or default_step, state=state, summary=first,
               next="none" if outcome == "done" else resume, question="", **known)
    print(body)
    return 0


def cmd_finish(spec, outcome, why, slice_, step, resume, left):
    if left and outcome != "done":
        raise Failed("--left goes with done only", REFUSE)
    return finish(Run(spec), outcome, why, slice_, step, resume, sys.stdin.read() if left == "-" else left)


def cmd_halt(spec, m, why):
    run = Run(spec)
    add_label(run, m, "agent:blocked")
    remove_label(run, m, "agent:in-progress")
    wt = run.root / f"issue-{m}"
    kept = f" Worktree kept at {wt}." if wt.is_dir() else ""
    gh(f"repos/{run.repo}/issues/{m}/comments", "--silent",
       "-f", f"body=drive-spec halted here: {why}.{kept} Resume with `/drive-spec {spec}` after fixing.")
    return finish(run, "halted", why, m)


def main():
    p = argparse.ArgumentParser(prog="drive-spec")
    sub = p.add_subparsers(dest="cmd", required=True)
    pl = sub.add_parser("plan", help="a spec's slices in build order, each with its state; exit 2 to refuse the spec")
    pl.add_argument("spec")
    pl.add_argument("--json", action="store_true")
    g = sub.add_parser("gate", help="print the run's verify gate, or pin one for the run")
    g.add_argument("spec")
    g.add_argument("command", nargs="?")
    v = sub.add_parser("verify", help="run the gate on a worktree's HEAD and record the verdict; exit 4 when red")
    v.add_argument("spec")
    v.add_argument("worktree")
    i = sub.add_parser("integrate", help="merge the spec branch into a slice, verify, push, merge its PR")
    i.add_argument("spec")
    i.add_argument("slice")
    i.add_argument("--deviations", help="the implementer's Deviations list, `none`, or `-` for stdin")
    la = sub.add_parser("land", help="close a merged slice, remove its worktree and branch, open the spec PR")
    la.add_argument("spec")
    la.add_argument("slice")
    pr = sub.add_parser("progress", help="refresh the progress comment on the spec")
    pr.add_argument("spec")
    fr = sub.add_parser("frontier", help="the next slices to build, continue or integrate, or why the run stops")
    fr.add_argument("spec")
    fr.add_argument("--running", default="", help="slices whose implementer is running now, comma-separated")
    fr.add_argument("--sequential", action="store_true")
    fr.add_argument("--max", type=int, dest="max_slices", help="maxSlices; default from .claude/drive-spec.json")
    fr.add_argument("--json", action="store_true")
    st = sub.add_parser("start", help="open a frontier slice's worktree, label it, print the implementer brief")
    st.add_argument("spec")
    st.add_argument("slice")
    h = sub.add_parser("halt", help="halt the run on a red slice: label, comment, status comment, status")
    h.add_argument("spec")
    h.add_argument("slice")
    h.add_argument("why", nargs="+")
    fi = sub.add_parser("finish", help="post the run's status comment and final status")
    fi.add_argument("spec")
    fi.add_argument("outcome", choices=sorted(OUTCOMES))
    fi.add_argument("--why")
    fi.add_argument("--slice", type=lambda v: int(v.lstrip("#")))
    fi.add_argument("--step")
    fi.add_argument("--resume", help="resume command; default /drive-spec <spec>")
    fi.add_argument("--left", help="with done: what the last review left open, or `-` for stdin")
    args = p.parse_args()
    spec = int(args.spec.lstrip("#"))
    try:
        if args.cmd == "plan":
            code = cmd_plan(spec, args.json)
        elif args.cmd == "gate":
            code = cmd_gate(spec, args.command)
        elif args.cmd == "verify":
            code = cmd_verify(spec, args.worktree)
        elif args.cmd == "integrate":
            code = cmd_integrate(spec, int(args.slice.lstrip("#")), args.deviations)
        elif args.cmd == "land":
            code = cmd_land(spec, int(args.slice.lstrip("#")))
        elif args.cmd == "progress":
            code = cmd_progress(spec)
        elif args.cmd == "frontier":
            running = [int(x.strip().lstrip("#")) for x in args.running.split(",") if x.strip()]
            code = cmd_frontier(spec, running, args.sequential, args.max_slices, args.json)
        elif args.cmd == "start":
            code = cmd_start(spec, int(args.slice.lstrip("#")))
        elif args.cmd == "halt":
            code = cmd_halt(spec, int(args.slice.lstrip("#")), " ".join(args.why).rstrip("."))
        elif args.cmd == "finish":
            code = cmd_finish(spec, args.outcome, args.why and args.why.rstrip("."), args.slice, args.step,
                              args.resume, args.left)
    except Failed as e:
        print(f"drive-spec: {e}", file=sys.stderr)
        code = e.code
    sys.exit(code)


if __name__ == "__main__":
    main()
