def pinned_gate(run):
    try:
        return (run.notes / "gate").read_text().strip() or None
    except FileNotFoundError:
        return None


def cmd_gate(spec, command, base):
    run = Run(spec)
    if command:
        old = pinned_gate(run)
        run.notes.mkdir(parents=True, exist_ok=True)
        (run.notes / "gate").write_text(command + "\n")
        (run.notes / "run.json").write_text(json.dumps({"started_at": stamp(), "gate": command}))
        base = base or run.base(fresh=True)
        run.status(step="guard", state="running", summary=f"resolved: base {base}, gate pinned",
                   next="drive-spec plan", base=base, question="")
        print(f"gate pinned: {command}" + (f" (was: {old})" if old and old != command else ""))
        return 0
    gate = pinned_gate(run) or run.config.get("verify")
    if not gate:
        raise Failed("no verify gate: pin one with `drive-spec gate <spec> '<command>'`", REFUSE)
    print(gate)
    return 0


def record(run, sha):
    try:
        return json.loads((run.notes / "verified" / f"{sha}.json").read_text())
    except (OSError, ValueError):
        return {}


class Heartbeat:
    """Keeps a running spec's status fresh while a gate runs or waits for the lock, so the dispatcher, which sees
    only an idle session waiting on a background task, does not call it stalled. For `pr-<n>`, the spec whose
    status names that PR."""

    def __init__(self, run):
        self.run, self.last, self.spec = run, time.monotonic(), None
        status = run.common / "drive-spec" / "status"
        n = run.spec
        for f in [status / f"spec-{n}.json"] if not isinstance(n, str) else sorted(status.glob("spec-*.json")):
            try:
                data = json.loads(f.read_text())
            except (OSError, ValueError):
                continue
            if data.get("state") == "running" and (not isinstance(n, str)
                                                   or (data.get("pr_url") or "").endswith(f"/pull/{n[3:]}")):
                self.spec = f.stem.removeprefix("spec-")
                break

    def beat(self):
        if self.spec and time.monotonic() - self.last >= HEARTBEAT_SECONDS:
            self.last = time.monotonic()
            script = Path(__file__).resolve().with_name("status.sh")
            subprocess.run([str(script), self.spec, "--touch"], cwd=self.run.repo_dir, timeout=60)


def verify_lock(head, wt, heartbeat):
    """The host-wide gate lock, one gate at a time; says who holds it before waiting."""
    lock = open(VERIFY_LOCK, "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.seek(0)
        print(f"waiting for the verify lock, held by {lock.read().strip() or 'a gate run outside drive-spec'}",
              flush=True)
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                heartbeat.beat()
                time.sleep(1)
    lock.seek(0)
    lock.truncate()
    lock.write(f"pid {os.getpid()} verifying {head[:12]} in {wt} since {now()}\n")
    lock.flush()
    return lock


def release(lock):
    lock.seek(0)
    lock.truncate()
    lock.close()


def stop_group(proc):
    try:
        os.killpg(proc.pid, signal.SIGTERM)
        proc.wait(timeout=10)
    except (ProcessLookupError, subprocess.TimeoutExpired):
        pass
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    proc.wait()


def run_gate(gate, wt, out, minutes, heartbeat, started=lambda pgid: None):
    """Run the gate in a process group of its own, stopped whole when it overruns or this script is killed."""
    proc = subprocess.Popen(["sh", "-c", gate], cwd=wt, stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
    started(proc.pid)

    def killed(signum, _frame):
        stop_group(proc)
        sys.exit(128 + signum)

    previous = {sig: signal.signal(sig, killed) for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}
    deadline = time.monotonic() + minutes * 60
    try:
        while True:
            try:
                return proc.wait(timeout=max(0.0, min(HEARTBEAT_SECONDS, deadline - time.monotonic())))
            except subprocess.TimeoutExpired:
                if time.monotonic() >= deadline:
                    stop_group(proc)
                    out.write(f"\ndrive-spec: the gate ran past {minutes:g} minutes and was stopped\n")
                    return TIMED_OUT
                heartbeat.beat()
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)


def run_gate_of(run):
    return pinned_gate(run) or run.config.get("verify")


def tree_of(run, sha):
    try:
        return git(run.repo_dir, "rev-parse", f"{sha}^{{tree}}")
    except Failed:
        return None


def green(run, sha, gate):
    """A green verdict from this gate on this commit, or on another with the very same tree (a merge commit
    GitHub made from a verified head): one from any other gate decides nothing."""
    rec = record(run, sha)
    if rec.get("exit") == 0 and rec.get("gate") == gate:
        return True
    tree = tree_of(run, sha)
    try:
        same = json.loads((run.notes / "verified" / f"tree-{tree}.json").read_text())
    except (OSError, ValueError):
        return False
    return bool(tree) and same.get("exit") == 0 and same.get("gate") == gate


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    try:
        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[0] not in "ZX"
    except (OSError, IndexError):
        return True


def claim_file(run, sha):
    return run.notes / "running" / f"{sha}.json"


def runner(run, sha):
    """The live gate run on this commit, as its claim records it, or None. A dead runner's claim is cleared."""
    f = claim_file(run, sha)
    try:
        info = json.loads(f.read_text())
    except (OSError, ValueError):
        return None
    if alive(info["pid"]):
        return info
    f.unlink(missing_ok=True)
    return None


def runners(run, wt=None):
    """Every live gate run of this spec, or of those inside `wt`."""
    d = run.notes / "running"
    found = [r for f in sorted(d.glob("*.json")) if (r := runner(run, f.stem))] if d.is_dir() else []
    if wt is not None:
        wt = os.path.realpath(wt)
        found = [r for r in found if r["wt"] == wt or r["wt"].startswith(wt + "/")]
    return found


def write_claim(run, sha, info, exclusive):
    """Write the claim whole, so a reader never sees half of one; `exclusive` fails when a claim is already there."""
    f = claim_file(run, sha)
    f.parent.mkdir(parents=True, exist_ok=True)
    tmp = f.with_name(f".{sha}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(info))
    try:
        if exclusive:
            os.link(tmp, f)
        else:
            os.replace(tmp, f)
            return True
    except FileExistsError:
        return False
    finally:
        tmp.unlink(missing_ok=True)
    return True


def claim(run, sha, wt, gate):
    """Become the one run of the gate on this commit. False when a live run already holds it."""
    info = {"pid": os.getpid(), "pgid": None, "sha": sha, "wt": os.path.realpath(wt), "gate": gate,
            "started_at": now()}
    for _ in range(2):
        if write_claim(run, sha, info, exclusive=True):
            return True
        if runner(run, sha):
            return False
    return False


def run_claimed(run, wt, head, gate):
    """Run the gate on a claimed commit and record its verdict; the claim goes when this does."""
    try:
        heartbeat = Heartbeat(run)
        minutes = run.config.get("verifyTimeoutMinutes") or VERIFY_TIMEOUT_MINUTES
        logs = run.notes / "logs"
        logs.mkdir(parents=True, exist_ok=True)
        log = logs / f"{head}.log"
        lock = verify_lock(head, wt, heartbeat)
        try:
            if green(run, head, gate):
                return
            info = runner(run, head) or {}

            def started(pgid):
                write_claim(run, head, dict(info, pgid=pgid), exclusive=False)

            begun = now()
            with open(log, "w") as out:
                code = run_gate(gate, wt, out, minutes, heartbeat, started)
        finally:
            release(lock)
        if git(wt, "rev-parse", "HEAD") != head:
            raise Failed(f"HEAD moved while the gate ran on {head[:12]}: nothing recorded")
        (run.notes / "verified").mkdir(exist_ok=True)
        verdict = json.dumps({"sha": head, "tree": tree_of(run, head), "gate": gate, "exit": code,
                              "started_at": begun, "finished_at": now(), "log": str(log), "minutes": minutes})
        (run.notes / "verified" / f"{head}.json").write_text(verdict)
        if code == 0:
            (run.notes / "verified" / f"tree-{tree_of(run, head)}.json").write_text(verdict)
    finally:
        claim_file(run, head).unlink(missing_ok=True)


def report(rec):
    """Print a verdict the way every caller reads it. True when green."""
    head = rec["sha"]
    if rec["exit"] == 0:
        print(f"green {head[:12]}")
        return True
    log = Path(rec["log"])
    try:
        print("".join(log.read_text().splitlines(keepends=True)[-40:]), end="")
    except OSError:
        pass
    minutes = rec.get("minutes") or VERIFY_TIMEOUT_MINUTES
    print(f"red {head[:12]}: " + (f"timed out after {minutes:g} minutes" if rec["exit"] == TIMED_OUT
                                  else f"exit {rec['exit']}") + f"; log {log}")
    return False


def attach(run, head, deadline, worker=None, heartbeat=None):
    """Wait for the run on this commit to end. Its record, or None when the deadline comes first."""
    heartbeat = heartbeat or Heartbeat(run)
    while True:
        if not runner(run, head) and not (worker and worker.poll() is None):
            return record(run, head) or {"sha": head, "missing": True}
        if deadline is not None and time.monotonic() >= deadline:
            return None
        heartbeat.beat()
        time.sleep(max(POLL_SECONDS, 0.05) if POLL_SECONDS else 0.05)


def settle(run, wt, deadline, keep=None):
    """Wait out every gate still running inside `wt` (but the one on `keep`). False when the deadline comes first."""
    for r in runners(run, wt):
        if r["sha"] == keep:
            continue
        print(f"waiting for the gate already running on {r['sha'][:12]} in this worktree", flush=True)
        if attach(run, r["sha"], deadline) is None:
            return False
    return True


def pending(head, wait):
    print(f"running {head[:12]}: the gate is still running after {wait:g} minutes; run this same command again "
          "to keep waiting")


def spawn_worker(run, wt, gate):
    cmd = [str(Path(__file__).resolve()), "verify", str(run.spec), str(wt), "--worker"]
    if isinstance(run.spec, str):
        cmd += ["--gate", gate]
    return subprocess.Popen(cmd, cwd=run.repo_dir, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True)


def verify(run, wt, gate=None, wait=None):
    """Run the gate on the worktree's HEAD, or attach to the run already on it, and report the verdict.
    True when green, False when red, None when `wait` minutes passed first: the gate runs on, detached."""
    wt = Path(wt).resolve()
    if dirty(wt):
        raise Failed(f"{wt} has uncommitted changes: commit them first, the verdict is recorded against a commit",
                     REFUSE)
    head = git(wt, "rev-parse", "HEAD")
    gate = gate or run_gate_of(run)
    if not gate:
        raise Failed("no verify gate: pin one with `drive-spec gate <spec> '<command>'`", REFUSE)
    if green(run, head, gate):
        print(f"green {head[:12]} (already verified)")
        return True
    deadline = None if wait is None else time.monotonic() + wait * 60
    if not settle(run, wt, deadline, keep=head):
        pending(head, wait)
        return None
    worker = None
    held = runner(run, head)
    if held:
        print(f"attached to the gate already running on {head[:12]} (pid {held['pid']})", flush=True)
    elif wait is None:
        if claim(run, head, wt, gate):
            run_claimed(run, wt, head, gate)
    else:
        worker = spawn_worker(run, wt, gate)
    rec = attach(run, head, deadline, worker)
    if rec is None:
        pending(head, wait)
        return None
    if rec.get("missing") or rec.get("gate") != gate:
        raise Failed(f"the gate run on {head[:12]} ended without a verdict; log {run.notes / 'logs' / f'{head}.log'}")
    return report(rec)


def cmd_verify(spec, wt, gate, wait, worker):
    if gate and not isinstance(spec, str):
        raise Failed("--gate goes with pr-<n> only: a spec's verdicts come from its pinned gate", REFUSE)
    run = Run(spec)
    if worker:
        wt = Path(wt).resolve()
        head = git(wt, "rev-parse", "HEAD")
        gate = gate or run_gate_of(run)
        if claim(run, head, wt, gate):
            run_claimed(run, wt, head, gate)
        return 0
    result = verify(run, wt, gate, wait)
    return PENDING if result is None else 0 if result else RED


def process_tree(cwds=True):
    """pid -> (parent pid, state, working directory or None, command line): /proc on Linux, else `ps` and `lsof`."""
    procs = {}
    if Path("/proc/self/stat").exists():
        for p in Path("/proc").glob("[0-9]*"):
            try:
                stat = (p / "stat").read_text()
                state, ppid = stat.rsplit(")", 1)[1].split()[:2]
                cmd = (p / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace").strip()
            except (OSError, ValueError):
                continue
            try:
                cwd = os.readlink(p / "cwd").removesuffix(" (deleted)") if cwds else None
            except OSError:
                cwd = None
            procs[int(p.name)] = (int(ppid), state, cwd, cmd)
        return procs
    for line in sh(["ps", "-Ao", "pid=,ppid=,stat=,args="]).splitlines():
        fields = line.split(None, 3)
        if len(fields) >= 3:
            procs[int(fields[0])] = (int(fields[1]), fields[2][0], None, fields[3] if len(fields) > 3 else "")
    if cwds:
        try:
            out = subprocess.run(["lsof", "-d", "cwd", "-Fpn"], capture_output=True, text=True, timeout=60).stdout
        except (OSError, subprocess.SubprocessError):
            out = ""
        pid = None
        for line in out.splitlines():
            if line.startswith("p"):
                pid = int(line[1:])
            elif line.startswith("n") and pid in procs:
                procs[pid] = procs[pid][:2] + (line[1:], procs[pid][3])
    return procs


def stop_gates_in(run, wt):
    """Stop the gate runs recorded inside a worktree about to be removed: one left there would run on in a deleted
    directory and could hold the verify lock for good. Anything else still running there is named, not stopped."""
    wt = os.path.realpath(wt)
    for r in runners(run, wt):
        print(f"stopped the gate on {r['sha'][:12]} in {Path(wt).name} (pid {r['pid']})")
        for kill in (lambda: os.kill(r["pid"], signal.SIGTERM), lambda: r["pgid"] and os.killpg(r["pgid"], signal.SIGTERM)):
            try:
                kill()
            except ProcessLookupError:
                pass
        deadline = time.time() + 10
        while alive(r["pid"]) and time.time() < deadline:
            time.sleep(0.1)
        for kill in (lambda: os.kill(r["pid"], signal.SIGKILL), lambda: r["pgid"] and os.killpg(r["pgid"], signal.SIGKILL)):
            try:
                kill()
            except ProcessLookupError:
                pass
        claim_file(run, r["sha"]).unlink(missing_ok=True)
    procs = process_tree()
    spared, pid = set(), os.getpid()
    while pid in procs and pid not in spared:
        spared.add(pid)
        pid = procs[pid][0]
    for pid, (_, state, cwd, cmd) in sorted(procs.items()):
        if pid not in spared and state not in "ZX" and cwd and (cwd == wt or cwd.startswith(wt + "/")):
            print(f"still running in {Path(wt).name}, not stopped: pid {pid} {cmd[:100] or '?'}")


def remove_worktree(run, wt):
    stop_gates_in(run, wt)
    git(run.repo_dir, "worktree", "remove", "--force", str(wt))


# integrate

def slice_worktree(run, m):
    wt = run.root / f"issue-{m}"
    if not wt.is_dir():
        raise Failed(f"no slice worktree at {wt}", REFUSE)
    branch = git(wt, "branch", "--show-current")
    if not branch.startswith(f"agent/issue-{m}-"):
        raise Failed(f"{wt} is on {branch or 'a detached HEAD'}, not agent/issue-{m}-*", REFUSE)
    return wt, branch


def bodied_commits(wt, since):
    out = git(wt, "log", "--no-merges", "--format=%h%x01%s%x01%b%x02", f"{since}..HEAD")
    commits = [c.strip().split("\x01") for c in out.split("\x02") if c.strip()]
    return [c[:2] for c in commits if c[2].strip()]


def merge_pr(run, pr, head):
    """Merge the PR at exactly `head`. True when merged, False when GitHub says it cannot merge."""
    for _ in range(40):
        state = json.loads(gh(f"repos/{run.repo}/pulls/{pr}", "--jq", "{mergeable, merged_at, head: .head.sha}"))
        if state["merged_at"]:
            return state["head"] == head
        if state["head"] == head and state["mergeable"] is not None:
            break
        time.sleep(POLL_SECONDS)
    else:
        raise Failed(f"GitHub never reported #{pr} mergeable at {head[:12]}")
    if not state["mergeable"]:
        return False
    gh("-X", "PUT", f"repos/{run.repo}/pulls/{pr}/merge", "-f", "merge_method=merge", "-f", f"sha={head}", "--silent")
    merged_at = gh(f"repos/{run.repo}/pulls/{pr}", "--jq", ".merged_at").strip()
    if merged_at in ("", "null"):
        raise Failed(f"#{pr} merge is queued or blocked: not landed")
    return True


def cmd_integrate(spec, m, deviations, wait=None):
    run = Run(spec)
    deadline = None if wait is None else time.monotonic() + wait * 60
    wt, branch = slice_worktree(run, m)
    if Path(git(wt, "rev-parse", "--absolute-git-dir"), "MERGE_HEAD").exists():
        raise Failed(f"a merge is in progress in {wt}: commit or abort it first", REFUSE)
    if dirty(wt):
        raise Failed(f"{wt} has uncommitted changes: the implementer commits everything first", REFUSE)
    run.notes.mkdir(parents=True, exist_ok=True)
    lock = open(run.notes / "integrate.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise Failed("another integration into the spec branch is running: one slice at a time", REFUSE)

    if inbox(run):
        return INBOX
    spec_branch = run.spec_branch()
    git(wt, "fetch", "--quiet", "origin")
    bad = bodied_commits(wt, f"origin/{spec_branch}")
    if bad:
        raise Failed("commits carry a body or trailer; reword each to its subject line only: "
                     + "; ".join(f"{sha} {subject}" for sha, subject in bad), REFUSE)

    open_prs = run.prs("open", spec_branch, branch)
    if open_prs:
        pr = open_prs[0]["number"]
    else:
        if not deviations:
            raise Failed("opening the slice PR needs --deviations: the implementer's list, or `none`", REFUSE)
        text = sys.stdin.read() if deviations == "-" else deviations
        text = re.sub(r"^\s*Deviations:\s*", "", text.strip())
        title = gh(f"repos/{run.repo}/issues/{m}", "--jq", ".title").strip()
        git(wt, "push", "--quiet", "-u", "origin", branch)
        pr = json.loads(gh(f"repos/{run.repo}/pulls", "-f", f"base={spec_branch}", "-f", f"head={branch}",
                           "-f", f"title={title}",
                           "-f", f"body=Slice of #{spec}. Ref #{m}.\n\nDeviations:\n{text}",
                           "--jq", "{number}"))["number"]
        print(f"opened #{pr}")

    for _ in range(SPEC_MOVES):
        if not settle(run, wt, deadline):
            print(f"#{m}: a gate still runs in {wt}; run `drive-spec integrate {spec} {m}` again to keep waiting")
            return PENDING
        git(wt, "fetch", "--quiet", "origin")
        target = git(wt, "rev-parse", f"origin/{spec_branch}")
        try:
            git(wt, "merge", "--quiet", "--no-edit", target)
        except Failed:
            files = git(wt, "diff", "--name-only", "--diff-filter=U").split()
            subprocess.run(["git", "-C", str(wt), "merge", "--abort"], capture_output=True)
            if not files:
                raise
            print(f"conflict merging {spec_branch} {target[:12]} into #{m}: {', '.join(files)}")
            print(f"next: a merger subagent runs `git merge {target}` in {wt}, resolves every conflict and "
                  f"commits; then `drive-spec integrate {spec} {m}` again")
            return CONFLICT
        left = None if deadline is None else max(0.0, (deadline - time.monotonic()) / 60)
        verdict = verify(run, wt, wait=left)
        if verdict is None:
            print(f"#{m}: run `drive-spec integrate {spec} {m}` again to keep waiting; it picks up where this stopped")
            return PENDING
        if not verdict:
            print(f"#{m} is red on the spec branch: halt the run; worktree kept at {wt}")
            return RED
        head = git(wt, "rev-parse", "HEAD")
        git(wt, "push", "--quiet", "origin", branch)
        git(wt, "fetch", "--quiet", "origin")
        if git(wt, "rev-parse", f"origin/{spec_branch}") != target:
            continue
        if merge_pr(run, pr, head):
            print(f"merged #{pr}: #{m} into {spec_branch} at {head[:12]}; next: drive-spec land {spec} {m}")
            return 0
        if git(wt, "rev-parse", f"origin/{spec_branch}") == target:
            raise Failed(f"GitHub reports #{pr} not mergeable, and the spec branch has not moved")
    raise Failed(f"the spec branch moved {SPEC_MOVES} times during integration: run integrate again")


# land

def progress_body(plan, base, spec_pr):
    lines = [MARKER, f"**Building `{plan['spec_branch']}` → `{base}`**", ""]
    for s in plan["slices"]:
        done = s["state"] == "closed"
        mark = (" ← held for a local run" if s["state"] == "held"
                else " ← building" if not done and "agent:in-progress" in s["labels"] else "")
        lines.append(f"- [{'x' if done else ' '}] #{s['number']} {s['title']}{mark}")
    if spec_pr:
        lines += ["", f"Spec PR: #{spec_pr['number']}"]
    lines += ["", f"_Updated {now()} from {socket.gethostname()}._"]
    return "\n".join(lines)


def post_progress(run, plan, base, spec_pr):
    ids = [c["id"] for c in json_lines(gh("--paginate", f"repos/{run.repo}/issues/{run.spec}/comments",
                                          "--jq", ".[] | {id, body}"))
           if (c.get("body") or "").startswith(MARKER)]
    body = progress_body(plan, base, spec_pr)
    if ids:
        gh("-X", "PATCH", f"repos/{run.repo}/issues/comments/{ids[0]}", "-f", f"body={body}", "--silent")
    else:
        gh(f"repos/{run.repo}/issues/{run.spec}/comments", "-f", f"body={body}", "--silent")


def spec_pr_of(run, base, branch):
    found = run.prs("open", base, branch)
    return found[0] if found else None


def slice_listing(plan):
    return "Slices, in build order:\n" + "\n".join(f"- #{x['number']} {x['title']}" for x in plan["slices"])


def ensure_spec_pr(run, plan, base):
    spec_pr = spec_pr_of(run, base, plan["spec_branch"])
    if not spec_pr:
        spec_pr = json.loads(gh(f"repos/{run.repo}/pulls", "-F", "draft=true", "-f", f"base={base}",
                                "-f", f"head={plan['spec_branch']}", "-f", f"title={plan['title']}",
                                "-f", f"body=Ref #{run.spec}\n\n{slice_listing(plan)}",
                                "--jq", "{number, url: .html_url}"))
        print(f"opened draft spec PR {spec_pr['url']}")
    return spec_pr


def checked_plan(run):
    plan = make_plan(run)
    if plan["refuse"]:
        raise Failed(f"refuse: {plan['refuse']}", REFUSE)
    if not plan["spec_branch"]:
        raise Failed(f"no spec branch agent/local-spec-{run.spec}-* on origin", REFUSE)
    return plan


def cmd_progress(spec):
    run = Run(spec)
    plan = checked_plan(run)
    base = run.base()
    post_progress(run, plan, base, spec_pr_of(run, base, plan["spec_branch"]))
    print(f"progress comment refreshed on #{spec}")
    return 0


def cmd_land(spec, m):
    run = Run(spec)
    plan = checked_plan(run)
    s = next((s for s in plan["slices"] if s["number"] == m), None)
    if not s:
        raise Failed(f"#{m} is not a slice of #{spec}", REFUSE)
    spec_branch = plan["spec_branch"]
    prefix = f"agent/issue-{m}-"
    merged = [p for p in run.prs("closed", spec_branch) if p["head"].startswith(prefix) and p["merged_at"]]
    if not merged:
        raise Failed(f"#{m} has no merged PR into {spec_branch}: integrate it first", REFUSE)
    pr = merged[0]

    spec_wt = run.root / f"spec-{spec}"
    if spec_wt.is_dir():
        git(spec_wt, "pull", "--quiet", "--ff-only")
    run.notes.mkdir(parents=True, exist_ok=True)
    if s["state"] != "closed":
        gh(f"repos/{run.repo}/issues/{m}/comments", "-f",
           f"body=Landed in #{pr['number']} on `{spec_branch}`.", "--silent")
        remember_issue(run, json.loads(gh("-X", "PATCH", f"repos/{run.repo}/issues/{m}", "-f", "state=closed",
                                          "-f", "state_reason=completed", "--jq", ISSUE_JQ)))
        s["state"] = "closed"
    if "agent:in-progress" in s["labels"]:
        remove_label(run, m, "agent:in-progress")
        s["labels"].remove("agent:in-progress")

    wt = run.root / f"issue-{m}"
    if wt.is_dir():
        remove_worktree(run, wt)
    git(run.repo_dir, "worktree", "prune")
    for b in git(run.repo_dir, "branch", "--list", f"{prefix}*", "--format=%(refname:short)").split():
        git(run.repo_dir, "branch", "-D", b)
    if not run.cloud:
        for b in run.heads(f"{prefix}*"):
            git(run.repo_dir, "push", "--quiet", "origin", "--delete", b)

    base = run.base()
    spec_pr = ensure_spec_pr(run, plan, base)
    post_progress(run, plan, base, spec_pr)

    with open(run.notes / "landed.jsonl", "a") as f:
        f.write(json.dumps({"slice": m, "pr": pr["number"], "at": stamp()}) + "\n")
    summary = progress_summary(plan)
    if all(x["state"] == "closed" for x in plan["slices"]):
        run.status(step="review", state="running", summary=f"{summary}; reviewing the spec branch",
                   pr_url=spec_pr["url"], branch=spec_branch, next="drive-spec reviewed once a review raises nothing new")
    else:
        run.status(step="build", state="running", summary=summary, pr_url=spec_pr["url"], branch=spec_branch,
                   next="integrate the next completed slice, or pick from the frontier")
    print(f"landed #{m} via #{pr['number']}; {summary}")
    return 0


# frontier and start

def landed_this_run(run):
    try:
        started = json.loads((run.notes / "run.json").read_text())["started_at"]
    except (OSError, ValueError, KeyError):
        raise Failed("no run start: pin the gate at step 1 (`drive-spec gate <spec> '<verify>'`), "
                     "so maxSlices counts only this run's landings", REFUSE)
    try:
        rows = [json.loads(line) for line in (run.notes / "landed.jsonl").read_text().splitlines() if line.strip()]
    except OSError:
        rows = []
    return len({r["slice"] for r in rows if r["at"] >= started})


def pick(plan, running=(), parallel=True, max_slices=None, landed=0, local_label=None):
    """What to do next from the plan alone: picks with their action, or why the run stops."""
    by = {s["number"]: s for s in plan["slices"]}
    open_ = [s for s in plan["slices"] if s["state"] != "closed"]
    out = {"picks": [], "running": [], "stop": None, "blocked": [], "held": [], "landed": landed}
    if not open_:
        out["stop"] = "done"
        return out
    out["blocked"] = [s["number"] for s in open_ if "agent:blocked" in s["labels"]]
    if out["blocked"]:
        out["stop"] = "blocked"
        return out
    out["running"] = running = sorted(m for m in set(running) if m in by and by[m]["state"] != "closed")
    out["held"] = [s["number"] for s in open_ if s["state"] == "held"]

    def local(s):
        return bool(local_label) and local_label in s["labels"]

    ready = sorted((s for s in open_ if s["state"] != "held" and s["number"] not in running
                    and all(by[b]["state"] == "closed" for b in s["blockers"])), key=lambda s: s["number"])
    room = None if max_slices is None else max(0, max_slices - landed - len(running))
    local_busy = any(local(by[m]) for m in running)
    if not parallel and running:
        ready = []
    for s in ready:
        if room is not None and len(out["picks"]) >= room:
            break
        if local(s):
            if local_busy:
                continue
            local_busy = True
        action = {"todo": "build", "in-flight": "continue", "open-pr": "integrate"}[s["state"]]
        out["picks"].append({"number": s["number"], "title": s["title"], "action": action,
                             "branch": s["branch"], "pr": s["pr"]})
        if not parallel:
            break
    if not out["picks"] and not running:
        out["stop"] = "ceiling" if max_slices is not None and landed >= max_slices else "held"
    return out


def render_picks(f):
    lines = []
    for p in f["picks"]:
        where = f" (PR #{p['pr']})" if p["pr"] else f" ({p['branch']})" if p["branch"] else ""
        lines.append(f"{p['action']} #{p['number']} {p['title']}{where}")
    lines += [f"running #{m}" for m in f["running"]]
    if f["stop"] == "ceiling":
        lines.append(f"stop: ceiling, {f['landed']} landed this run")
    elif f["stop"] == "held":
        lines.append("stop: held, only held slices and those they block remain: "
                     + ", ".join(f"#{m}" for m in f["held"]))
    elif f["stop"]:
        lines.append(f"stop: {f['stop']}")
    elif not f["picks"]:
        lines.append("wait: for a running implementer to finish")
    return "\n".join(lines)


def cmd_frontier(spec, running, sequential, max_slices, as_json):
    run = Run(spec)
    if inbox(run):
        return INBOX
    plan = checked_plan(run)
    parallel, max_slices = run.mode(sequential, max_slices)
    f = pick(plan, running, parallel, max_slices, landed_this_run(run) if max_slices is not None else 0,
             (run.config.get("localOnly") or {}).get("label"))
    if f["stop"] == "blocked":
        raise Failed(", ".join(f"#{m}" for m in f["blocked"]) + " carries agent:blocked: the operator removes it "
                     "after fixing, and only then does the run go on", REFUSE)
    if f["stop"] == "done" and run.current().get("step") == "build":
        # The last slice closed outside `land` (closed by hand, or on a resume): mark review begun here.
        run.status(step="review", state="running", summary=f"{progress_summary(plan)}; reviewing the spec branch",
                   next="drive-spec reviewed once a review raises nothing new")
    print(json.dumps(f, indent=2) if as_json else render_picks(f))
    return 0


def slug_of(title):
    return re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:40].rstrip("-")


def ensure_excluded(run):
    try:
        rel = run.root.relative_to(run.repo_dir).as_posix() + "/"
    except ValueError:
        return
    exclude = run.common / "info" / "exclude"
    lines = exclude.read_text().splitlines() if exclude.exists() else []
    if rel not in lines:
        exclude.parent.mkdir(exist_ok=True)
        with open(exclude, "a") as f:
            f.write(rel + "\n")


def bootstrap(run, wt):
    """Bootstrap a worktree until it has succeeded once with this command: a marker in the worktree's own git dir
    records it, so a worktree whose bootstrap failed is bootstrapped again on the next try. Output goes to a log."""
    command = run.config.get("bootstrap")
    if not command:
        return
    marker = Path(git(wt, "rev-parse", "--absolute-git-dir")) / "drive-spec-bootstrap"
    digest = hashlib.sha256(command.encode()).hexdigest()
    try:
        if marker.read_text().strip() == digest:
            return
    except OSError:
        pass
    logs = run.notes / "logs"
    logs.mkdir(parents=True, exist_ok=True)
    log = logs / f"bootstrap-{Path(wt).name}.log"
    with open(log, "w") as out:
        code = subprocess.run(["sh", "-c", command], cwd=wt, stdin=subprocess.DEVNULL, stdout=out,
                              stderr=subprocess.STDOUT).returncode
    if code != 0:
        print("".join(log.read_text().splitlines(keepends=True)[-40:]), end="")
        raise Failed(f"bootstrap exited {code} in {wt}; log {log}. Fix the cause, then run this command again: "
                     "it bootstraps again until one succeeds")
    marker.write_text(digest + "\n")
    print(f"bootstrapped {Path(wt).name}; log {log}")


def fill(name, values, conditions=None):
    """A brief from its template file: the markdown block, `<If x: "...">` kept when `x` holds, placeholders filled.
    A placeholder left unfilled fails the command, so a new one goes into its caller too."""
    text = Path(__file__).resolve().with_name(name).read_text()
    body = text.split("```markdown\n", 1)[1].rsplit("\n```", 1)[0]
    for key, keep in (conditions or {}).items():
        body = re.sub(rf'<If {key}: "(.*?)">', lambda x: x.group(1) if keep else "", body)
    for key, value in values.items():
        body = body.replace(f"<{key}>", str(value))
    body = re.sub(r" +\n", "\n", body).strip()
    left = re.findall(r"<(?:If [A-Za-z]+:[^>]*|[a-z][a-z ]*)>", body)
    if left:
        raise Failed(f"{name} has placeholders the script does not fill: {', '.join(left)}")
    return body


def brief(run, m, wt, base, continuing, local_only):
    local = run.config.get("localOnly") or {}
    return fill("IMPLEMENTER.md", {
        "path": wt, "m": m, "repo": run.repo, "spec": run.spec, "base": f"origin/{base}", "notes": run.notes,
        "skill dir": Path(__file__).resolve().parent, "label": local.get("label", ""),
        "proof": local.get("proof", "")}, {
        "continuing": continuing, "localOnly": local_only, "decided": (run.notes / "decisions.md").is_file(),
        "covered": bool(owned_requirements(run, m))})


def write_brief(run, name, text):
    run.notes.mkdir(parents=True, exist_ok=True)
    path = run.notes / name
    path.write_text(text + "\n")
    print(f"brief: {path}")
    return path


def cmd_start(spec, m):
    run = Run(spec)
    plan = checked_plan(run)
    by = {s["number"]: s for s in plan["slices"]}
    s = by.get(m)
    if not s:
        raise Failed(f"#{m} is not a slice of #{spec}", REFUSE)
    if s["state"] == "closed":
        raise Failed(f"#{m} is closed", REFUSE)
    if s["state"] == "held":
        raise Failed(f"#{m} is held: only a local session builds it", REFUSE)
    if "agent:blocked" in s["labels"]:
        raise Failed(f"#{m} carries agent:blocked: the operator removes it after fixing", REFUSE)
    waiting = [f"#{b}" for b in s["blockers"] if by[b]["state"] != "closed"]
    if waiting:
        raise Failed(f"#{m} is not on the frontier: blocked by {', '.join(waiting)}", REFUSE)

    ensure_excluded(run)
    wt = run.root / f"issue-{m}"
    prefix = f"agent/issue-{m}-"
    if wt.is_dir():
        branch = git(wt, "branch", "--show-current")
        if not branch.startswith(prefix):
            raise Failed(f"{wt} is on {branch or 'a detached HEAD'}, not {prefix}*", REFUSE)
    else:
        git(run.repo_dir, "fetch", "--quiet", "--prune", "origin")
        local = git(run.repo_dir, "branch", "--list", f"{prefix}*", "--format=%(refname:short)").split()
        remote = run.heads(f"{prefix}*")
        if local:
            branch = local[0]
            git(run.repo_dir, "worktree", "add", "-q", str(wt), branch)
        elif remote:
            branch = remote[0]
            git(run.repo_dir, "worktree", "add", "-q", str(wt), "-b", branch, f"origin/{branch}")
        else:
            branch = prefix + slug_of(s["title"])
            spec_wt = run.root / f"spec-{spec}"
            if spec_wt.is_dir():
                git(spec_wt, "pull", "--quiet", "--ff-only")
                start = git(spec_wt, "rev-parse", "HEAD")
            else:
                start = f"origin/{plan['spec_branch']}"
            git(run.repo_dir, "worktree", "add", "-q", str(wt), "-b", branch, start)
    bootstrap(run, wt)
    if "agent:in-progress" not in s["labels"]:
        add_label(run, m, "agent:in-progress")
        s["labels"].append("agent:in-progress")
    run.status(step="build", state="running", summary=progress_summary(plan), branch=plan["spec_branch"],
               next=f"integrate #{m}" if s["state"] == "open-pr" else f"implementer builds #{m}")
    print(f"worktree {wt} on {branch}")
    if s["state"] == "open-pr":
        print(f"#{m} already has PR #{s['pr']}: drive-spec integrate {spec} {m}")
        return 0
    base = run.base()
    continuing = git(wt, "rev-list", "--count", f"origin/{plan['spec_branch']}..HEAD") != "0"
    local_label = (run.config.get("localOnly") or {}).get("label")
    path = write_brief(run, f"brief-{m}.md",
                       brief(run, m, wt, base, continuing, bool(local_label) and local_label in s["labels"]))
    print(f"next: an implementer subagent with the prompt `Read {path} and follow it.`")
    return 0


# open, confirm, cleanup

def cmd_open(spec, base):
    run = Run(spec)
    plan = make_plan(run)
    if plan["refuse"]:
        raise Failed(f"refuse: {plan['refuse']}", REFUSE)
    base = base or run.base()
    ensure_excluded(run)
    wt = run.root / f"spec-{spec}"
    prefix = f"agent/local-spec-{spec}-"
    git(run.repo_dir, "fetch", "--quiet", "--prune", "origin")
    remote = run.heads(f"{prefix}*")
    if len(remote) > 1:
        raise Failed(f"several spec branches on origin: {', '.join(remote)}", REFUSE)
    if wt.is_dir():
        branch = git(wt, "branch", "--show-current")
        if not branch.startswith(prefix):
            raise Failed(f"{wt} is on {branch or 'a detached HEAD'}, not {prefix}*", REFUSE)
        if remote:
            git(wt, "pull", "--quiet", "--ff-only", "origin", branch)
        how = "reused"
    elif remote:
        branch = remote[0]
        ahead = subprocess.run(["git", "-C", str(run.repo_dir), "merge-base", "--is-ancestor", f"origin/{branch}",
                                f"refs/heads/{branch}"], capture_output=True).returncode == 0
        if ahead:
            git(run.repo_dir, "worktree", "add", "-q", str(wt), branch)
        else:
            git(run.repo_dir, "worktree", "add", "-q", str(wt), "-B", branch, f"origin/{branch}")
        git(wt, "branch", "--quiet", "--set-upstream-to", f"origin/{branch}")
        how = "resumed"
    else:
        local = git(run.repo_dir, "branch", "--list", f"{prefix}*", "--format=%(refname:short)").split()
        branch = local[0] if local else prefix + slug_of(plan["title"])
        git(run.repo_dir, "worktree", "add", "-q", str(wt), *([branch] if local else ["-b", branch, f"origin/{base}"]))
        how = "cut from " + ("the local branch" if local else f"origin/{base}")
    if not remote or git(wt, "rev-list", "--count", f"origin/{branch}..HEAD") != "0":
        git(wt, "push", "--quiet", "-u", "origin", branch)
    if git(wt, "rev-parse", "HEAD") != git(wt, "rev-parse", f"origin/{branch}"):
        raise Failed(f"{wt} is not at origin/{branch}: it has diverged; settle it by hand", REFUSE)
    bootstrap(run, wt)
    run.status(step="preview", state="running", summary=f"spec worktree {how}: {branch}", next="drive-spec preview",
               branch=branch, base=base)
    print(f"worktree {wt} on {branch} ({how})")
    return INBOX if inbox(run) else 0


# preview, explore and review: the ends of steps 4, 5 and 7

def cmd_preview(spec, sequential, max_slices, dry_run):
    run = Run(spec)
    if inbox(run):
        return INBOX
    plan = checked_plan(run)
    base = run.base()
    parallel, max_slices = run.mode(sequential, max_slices)
    post_progress(run, plan, base, spec_pr_of(run, base, plan["spec_branch"]))
    print(f"base: {base}\nspec branch: {plan['spec_branch']}\nworktree root: {run.root}\n"
          f"mode: {'parallel' if parallel else 'sequential'}\nceiling: {max_slices or 'none'}\n")
    print(render(plan))
    summary = progress_summary(plan)
    if dry_run:
        run.status(step="preview", state="paused", summary=f"dry run: {summary}", next=f"/drive-spec {spec}")
    else:
        open_ = sum(x["state"] != "closed" for x in plan["slices"])
        run.status(step="explore", state="running", summary=f"{summary}; exploring {open_} open slice(s)",
                   next="drive-spec explored once the notes and conflicts.md are written")
    return 0


def run_started(run):
    try:
        return datetime.fromisoformat(json.loads((run.notes / "run.json").read_text())["started_at"])
    except (OSError, ValueError, KeyError):
        raise Failed("no run start: pin the gate at step 1 (`drive-spec gate <spec> '<verify>'`)", REFUSE)


COVERAGE_ITEM = re.compile(r"^\s*[-*]\s+(.*)$")
COVERAGE_ARROW = re.compile(r"\s*(?:→|->)\s*")
COVERAGE_SLICES = re.compile(r"(#\d+(?:\s*,\s*#\d+)*)(?:\s+\(.*\))?")
COVERAGE_KEYWORD = re.compile(r"(unmapped|every slice)(?:\s+\(.*\))?", re.I)
QUESTION_LINE = re.compile(r"^\s*[-*]\s+(Q\d+):\s*(.+?)\s*$")


def coverage_target(text):
    """A coverage line's target in its canonical form, its trailing `(note)` dropped; None when it fits no form."""
    if m := COVERAGE_SLICES.fullmatch(text):
        return ", ".join(re.findall(r"#\d+", m.group(1)))
    if m := COVERAGE_KEYWORD.fullmatch(text):
        return m.group(1).lower()
    if text.lower().startswith("out of scope:"):
        return text
    return None


def coverage(run):
    """coverage.md as (requirement, target) pairs, and the lines that fit no form.
    The line splits at the rightmost arrow whose target fits a form, so a requirement may hold an arrow itself."""
    try:
        lines = (run.notes / "coverage.md").read_text().splitlines()
    except OSError:
        return [], []
    pairs, bad = [], []
    for line in lines:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        item = COVERAGE_ITEM.match(line)
        arrows = list(COVERAGE_ARROW.finditer(item.group(1))) if item else []
        for arrow in reversed(arrows):
            requirement, target = item.group(1)[:arrow.start()].strip(), item.group(1)[arrow.end():].strip()
            if requirement and (target := coverage_target(target)) is not None:
                pairs.append((requirement, target))
                break
        else:
            bad.append(line.strip())
    return pairs, bad


def owned_requirements(run, m):
    return [req for req, target in coverage(run)[0]
            if target == "every slice" or f"#{m}" in re.findall(r"#\d+", target)]


def questions(run):
    try:
        lines = (run.notes / "questions.md").read_text().splitlines()
    except OSError:
        return []
    return [(m.group(1), m.group(2)) for m in map(QUESTION_LINE.match, lines) if m]


def answered_refs(run):
    try:
        text = (run.notes / "decisions.md").read_text()
    except OSError:
        return set()
    return {ref.strip() for group in re.findall(r"^- \[([^\]]+)\]", text, re.M) for ref in group.split(",")}


def cmd_explore(spec):
    run = Run(spec)
    plan = checked_plan(run)
    open_ = [x["number"] for x in plan["slices"] if x["state"] != "closed"]
    todo = [m for m in open_ if not (run.notes / f"issue-{m}.md").is_file()]
    wt = run.root / f"spec-{spec}"
    if not wt.is_dir():
        raise Failed(f"no spec worktree at {wt}: `drive-spec open {spec}`", REFUSE)
    path = write_brief(run, "brief-explore.md", fill("EXPLORER.md", {
        "path": wt, "repo": run.repo, "spec": spec, "notes": run.notes,
        "open": ", ".join(f"#{m}" for m in open_) or "none",
        "todo": ", ".join(f"issue-{m}.md" for m in todo) or "every slice already has one; refresh none"}))
    print(f"next: a general-purpose subagent with the prompt `Read {path} and follow it.`; then "
          f"`drive-spec explored {spec}`")
    return 0


def cmd_explored(spec):
    run = Run(spec)
    plan = checked_plan(run)
    started = run_started(run)
    missing = [f"issue-{x['number']}.md" for x in plan["slices"]
               if x["state"] != "closed" and not (run.notes / f"issue-{x['number']}.md").is_file()]
    fresh = ["conflicts.md", "coverage.md", "questions.md"]
    missing += [name for name in fresh if not (run.notes / name).is_file()]
    if missing:
        raise Failed(f"explore is not done: no {', '.join(missing)} in {run.notes}", REFUSE)
    stale = [name for name in fresh
             if datetime.fromtimestamp((run.notes / name).stat().st_mtime, timezone.utc) < started]
    if stale:
        raise Failed(f"{', '.join(stale)} in {run.notes} predate this run: check the spec and the open slices "
                     "again and write them fresh", REFUSE)
    if (run.notes / "conflicts.md").read_text().strip():
        finish(run, "conflicts")
        return CONFLICT
    pairs, bad = coverage(run)
    if bad:
        raise Failed("coverage.md lines fit no form (`- <requirement> → #<m>`, `→ every slice`, `→ unmapped`, "
                     "`→ out of scope: <the spec's words>`, each but the last with an optional trailing "
                     "`(note)`): " + "; ".join(bad), REFUSE)
    if not pairs:
        raise Failed("coverage.md maps no requirement: every requirement in the spec gets a line", REFUSE)
    slices = {f"#{x['number']}" for x in plan["slices"]}
    strays = sorted({ref for _, target in pairs if target.startswith("#")
                     for ref in re.findall(r"#\d+", target)} - slices)
    if strays:
        raise Failed(f"coverage.md names {', '.join(strays)}, not slices of #{spec}", REFUSE)
    unmapped = [req for req, target in pairs if target.lower() == "unmapped"]
    if unmapped:
        raise Failed("spec requirements no slice owns: " + "; ".join(unmapped) + ". Ask the operator which slice "
                     "owns each, or whether it is out of scope (`drive-spec ask`), then record the answer in "
                     "coverage.md and run this again", REFUSE)
    asked = answered_refs(run)
    waiting = [(ref, q) for ref, q in questions(run) if ref not in asked]
    if waiting:
        raise Failed("the spec leaves these to the operator, and they are unanswered: "
                     + "; ".join(f"{ref}: {q}" for ref, q in waiting)
                     + f". Ask them before any build: `drive-spec ask {spec} '<question>' --ref "
                     + ",".join(ref for ref, _ in waiting) + "`", REFUSE)
    open_ = sum(x["state"] != "closed" for x in plan["slices"])
    run.status(step="build", state="running", summary=f"explored {open_} open slice(s), no conflicts; "
               f"{progress_summary(plan)}", next="drive-spec frontier", branch=plan["spec_branch"])
    print(f"explored: notes for {open_} open slice(s), no conflicts")
    return 0


REVIEW_ROUNDS = 3
SOURCE = re.compile(r"spec #\d+|#\d+|decisions\.md|coverage\.md")


def review_rounds(run):
    d = run.notes / "review"
    return sorted(int(m.group(1)) for f in d.glob("round-*.brief.md")
                  if (m := re.fullmatch(r"round-(\d+)\.brief\.md", f.name))) if d.is_dir() else []


def round_file(run, k, kind):
    return run.notes / "review" / f"round-{k}.{kind}"


def read_round(run, k, wt):
    """A round's findings, held to the form REVIEWER.md sets. Refuses one that does not fit, naming each fault."""
    head = json.loads(round_file(run, k, "meta.json").read_text())["head"]
    f = round_file(run, k, "json")
    try:
        data = json.loads(f.read_text())
    except ValueError as e:
        raise Failed(f"{f} is not JSON ({e}): send the round's reviewer back to rewrite it", REFUSE)
    faults = []
    if not isinstance(data, dict) or not isinstance(data.get("findings"), list):
        raise Failed(f"{f} has no findings list: send the round's reviewer back to rewrite it", REFUSE)
    if data.get("head") != head:
        faults.append(f"head is {data.get('head')}, the round reviewed {head}")
    for n, x in enumerate(data["findings"], 1):
        if not isinstance(x, dict) or x.get("kind") not in ("rule", "judgement"):
            faults.append(f"finding {n}: kind is neither rule nor judgement")
            continue
        if not str(x.get("finding") or "").strip():
            faults.append(f"finding {n}: no finding text")
        if x.get("path") and not (Path(wt) / x["path"]).exists():
            faults.append(f"finding {n}: no file {x['path']}")
        if x["kind"] == "rule":
            source = str(x.get("rule") or "").split(":", 1)
            if len(source) < 2 or not source[1].strip():
                faults.append(f"finding {n}: a rule finding quotes no rule (`SOURCE: THE RULE`)")
            elif not (SOURCE.fullmatch(source[0].strip()) or (Path(wt) / source[0].strip()).is_file()):
                faults.append(f"finding {n}: {source[0].strip()} is no file, spec, slice or decisions.md")
    if faults:
        raise Failed(f"{f} does not fit REVIEWER.md: " + "; ".join(faults)
                     + ". Send the round's reviewer back to fix it", REFUSE)
    return data


def where(x):
    return f"`{x['path']}:{x['line']}`" if x.get("path") and x.get("line") else f"`{x['path']}`" if x.get("path") \
        else "(missing)"


def judgement_calls(run, wt):
    seen, out = set(), []
    for k in review_rounds(run):
        if round_file(run, k, "json").is_file():
            for x in read_round(run, k, wt)["findings"]:
                key = (x.get("path"), " ".join(x["finding"].split()).lower())
                if x["kind"] == "judgement" and key not in seen:
                    seen.add(key)
                    out.append(f"- {where(x)}: {' '.join(x['finding'].split())}")
    return out


def spec_head(run, plan, push):
    """The spec worktree's HEAD, clean, level with origin and green; with `push`, a green HEAD ahead is pushed."""
    spec = run.spec
    wt = run.root / f"spec-{spec}"
    if not wt.is_dir():
        raise Failed(f"no spec worktree at {wt}: `drive-spec open {spec}`", REFUSE)
    if dirty(wt):
        raise Failed(f"{wt} has uncommitted changes: commit the fixes, then verify", REFUSE)
    branch = plan["spec_branch"]
    on = git(wt, "branch", "--show-current")
    if on != branch:
        behind = subprocess.run(["git", "-C", str(wt), "merge-base", "--is-ancestor", branch, "HEAD"],
                                capture_output=True).returncode == 0
        if on or not behind:
            raise Failed(f"{wt} is on {on or 'a detached HEAD'}, not {branch}: check out {branch} with the fixes "
                         "on it", REFUSE)
        detached = git(wt, "rev-parse", "HEAD")
        git(wt, "switch", "--quiet", branch)
        git(wt, "merge", "--ff-only", "--quiet", detached)
        print(f"reattached {branch} at {detached[:12]}")
    git(wt, "fetch", "--quiet", "origin")
    head, remote = git(wt, "rev-parse", "HEAD"), git(wt, "rev-parse", f"origin/{branch}")
    gate = run_gate_of(run)
    verify_cmd = f"`drive-spec verify {spec} {wt} --wait-minutes 9`"
    if head != remote:
        if git(wt, "rev-list", "--count", f"HEAD..origin/{branch}") != "0":
            if git(wt, "rev-list", "--count", f"origin/{branch}..HEAD") != "0":
                raise Failed(f"{wt} and origin/{branch} have diverged: settle it by hand", REFUSE)
            git(wt, "pull", "--quiet", "--ff-only")
            head = remote
        elif not push:
            raise Failed(f"{wt} is not at origin/{branch}: push the fixes", REFUSE)
        elif not green(run, head, gate):
            raise Failed(f"{head[:12]} is not verified green: {verify_cmd}, then this again", REFUSE)
        else:
            git(wt, "push", "--quiet", "origin", f"HEAD:refs/heads/{branch}")
            git(wt, "fetch", "--quiet", "origin")
            if git(wt, "rev-parse", f"origin/{branch}") != head:
                raise Failed(f"pushed {head[:12]} to {branch}, but origin/{branch} is not there: push by hand")
            print(f"pushed {head[:12]} to {branch}")
    if not green(run, head, gate):
        raise Failed(f"{head[:12]} is not verified green: {verify_cmd}, then this again", REFUSE)
    return wt, head


def cmd_review(spec):
    run = Run(spec)
    plan = checked_plan(run)
    open_ = [f"#{x['number']}" for x in plan["slices"] if x["state"] != "closed"]
    if open_:
        raise Failed(f"not every slice is closed: {', '.join(open_)}", REFUSE)
    wt, head = spec_head(run, plan, push=True)
    ks = review_rounds(run)
    k = ks[-1] if ks else 0
    decided = (run.notes / "decisions.md").is_file()
    if k:
        result = round_file(run, k, "json")
        if not result.is_file():
            print(f"round {k} waits for its reviewer: a subagent with the prompt "
                  f"`Read {round_file(run, k, 'brief.md')} and follow it.`; then `drive-spec review {spec}` again")
            return 0
        data = read_round(run, k, wt)
        rules = [x for x in data["findings"] if x["kind"] == "rule"]
        calls = len(data["findings"]) - len(rules)
        if data["head"] == head and not rules:
            run.status(step="review", state="running", summary=f"review clean at round {k}, {calls} judgement "
                       f"call(s) this round", next=f"drive-spec reviewed {spec}", branch=plan["spec_branch"])
            print(f"review clean at round {k}: next `drive-spec reviewed {spec}`")
            return 0
        if data["head"] == head:
            fix = round_file(run, k, "fix.md")
            if not fix.is_file():
                findings = "\n".join(f"{n}. {where(x)}: {' '.join(x['finding'].split())}\n   Rule: {x['rule']}"
                                     for n, x in enumerate(rules, 1))
                fix.write_text(fill("REVIEW-FIXER.md", {
                    "path": wt, "spec": spec, "repo": run.repo, "notes": run.notes, "k": k, "findings": findings,
                    "skill dir": Path(__file__).resolve().parent}, {"decided": decided}) + "\n")
            run.status(step="review", state="running", summary=f"review round {k}: {len(rules)} rule finding(s), "
                       "fixing", next=f"drive-spec review {spec} once the fixes are green", branch=plan["spec_branch"])
            print(f"round {k} raised {len(rules)} rule finding(s) and {calls} judgement call(s)")
            print(f"next: an implementer subagent with the prompt `Read {fix} and follow it.`; then "
                  f"`drive-spec review {spec}` again")
            return 0
        cap = run.config.get("reviewRounds") or REVIEW_ROUNDS
        answered = decided and (run.notes / "decisions.md").stat().st_mtime > result.stat().st_mtime
        if k >= cap and rules and not answered:
            raise Failed(f"{k} review rounds and round {k} still raised rule findings: ask the operator whether to "
                         f"go on (`drive-spec ask {spec} ...`); once answered, `drive-spec review {spec}` starts "
                         "another round", REFUSE)
    k += 1
    (run.notes / "review").mkdir(parents=True, exist_ok=True)
    round_file(run, k, "meta.json").write_text(json.dumps({"head": head, "at": stamp()}))
    earlier = [str(round_file(run, j, "json")) for j in range(1, k)]
    slices = ", ".join(f"#{x['number']}" for x in plan["slices"])
    brief_path = round_file(run, k, "brief.md")
    brief_path.write_text(fill("REVIEWER.md", {
        "path": wt, "head": head, "base": run.base(), "spec": spec, "repo": run.repo, "slices": slices,
        "notes": run.notes, "k": k, "earlier": ", ".join(f"`{e}`" for e in earlier),
        "out": round_file(run, k, "json")}, {
        "decided": decided, "covered": (run.notes / "coverage.md").is_file(), "earlier": bool(earlier)}) + "\n")
    run.status(step="review", state="running", summary=f"review round {k} at {head[:12]}",
               next=f"drive-spec review {spec} once the reviewer writes its findings", branch=plan["spec_branch"])
    print(f"brief: {brief_path}")
    print(f"next: a reviewer subagent with the prompt `Read {brief_path} and follow it.`; then "
          f"`drive-spec review {spec}` again")
    return 0


def cmd_reviewed(spec, left):
    run = Run(spec)
    plan = checked_plan(run)
    open_ = [f"#{x['number']}" for x in plan["slices"] if x["state"] != "closed"]
    if open_:
        raise Failed(f"not every slice is closed: {', '.join(open_)}", REFUSE)
    branch = plan["spec_branch"]
    wt, head = spec_head(run, plan, push=False)
    ks = review_rounds(run)
    if not ks or not round_file(run, ks[-1], "json").is_file():
        raise Failed(f"no finished review round: `drive-spec review {spec}`", REFUSE)
    last = read_round(run, ks[-1], wt)
    if last["head"] != head or any(x["kind"] == "rule" for x in last["findings"]):
        raise Failed(f"round {ks[-1]} is not a clean review of {head[:12]}: `drive-spec review {spec}`", REFUSE)
    kept = run.notes / "left.md"
    lines = judgement_calls(run, wt) + ([left.strip()] if left and left.strip() else [])
    if lines:
        kept.write_text("\n".join(lines) + "\n")
    else:
        kept.unlink(missing_ok=True)
    spec_pr = spec_pr_of(run, run.base(), branch)
    summary = (f"review left {len(lines)} finding(s) open" if lines else "review clean") + \
        f" after {len(ks)} round(s) at {head[:12]}"
    run.status(step="confirm", state="running", summary=summary, next="drive-spec confirm",
               branch=branch, **({"pr_url": spec_pr["url"]} if spec_pr else {}))
    print(summary)
    return 0


def left_of(body):
    m = re.search(r"^Left from review:\s*\n(.*)\Z", body or "", re.S | re.M)
    return m.group(1).strip() if m else ""


def deviations_of(body):
    m = re.search(r"^Deviations:\s*\n?(.*)\Z", body or "", re.S | re.M)
    text = (m.group(1) if m else "").strip()
    return "" if text.lower().rstrip(".") in ("", "none") else text


def cmd_confirm(spec, left):
    run = Run(spec)
    if inbox(run):
        return INBOX
    plan = checked_plan(run)
    if left is None:
        try:
            left = (run.notes / "left.md").read_text()
        except FileNotFoundError:
            pass
    open_ = [f"#{x['number']}" for x in plan["slices"] if x["state"] != "closed"]
    if open_:
        raise Failed(f"not every slice is closed: {', '.join(open_)}", REFUSE)
    base = run.base()
    spec_pr = ensure_spec_pr(run, plan, base)
    merged = [p for p in run.prs("closed", plan["spec_branch"]) if p["merged_at"]]
    pr_body = {}
    for p in merged:
        m = re.match(r"agent/issue-(\d+)-", p["head"])
        if m:
            pr_body[int(m.group(1))] = json.loads(gh(f"repos/{run.repo}/pulls/{p['number']}", "--jq", "{body}"))["body"]
    found = [(x, deviations_of(pr_body.get(x["number"]))) for x in plan["slices"]]
    found = [(x, d) for x, d in found if d]
    body = f"Closes #{spec}\n\n{slice_listing(plan)}\n\n"
    body += ("Deviations:\n\n" + "\n\n".join(f"#{x['number']} {x['title']}\n{d}" for x, d in found)) if found \
        else "Deviations: none"
    if left:
        body += "\n\nLeft from review:\n" + left.strip()
    gh("-X", "PATCH", f"repos/{run.repo}/pulls/{spec_pr['number']}", "-f", f"body={body}", "--silent")
    post_progress(run, plan, base, spec_pr)
    summary = f"spec PR #{spec_pr['number']} closes #{spec}; {len(found)} slice(s) with deviations"
    run.status(step="cleanup", state="running", summary=summary, next="drive-spec cleanup", pr_url=spec_pr["url"],
               branch=plan["spec_branch"])
    print(f"{summary}: {spec_pr['url']}")
    return 0


def cmd_cleanup(spec):
    run = Run(spec)
    if inbox(run):
        return INBOX
    plan = checked_plan(run)
    open_ = [f"#{x['number']}" for x in plan["slices"] if x["state"] != "closed"]
    if open_:
        raise Failed(f"not every slice is closed: {', '.join(open_)}; their worktrees hold work", REFUSE)
    spec_wt = run.root / f"spec-{spec}"
    if spec_wt.is_dir():
        if dirty(spec_wt):
            raise Failed(f"{spec_wt} has uncommitted changes", REFUSE)
        branch = git(spec_wt, "branch", "--show-current")
        git(spec_wt, "fetch", "--quiet", "origin")
        if branch and git(spec_wt, "rev-list", "--count", f"origin/{branch}..HEAD") != "0":
            raise Failed(f"{spec_wt} has commits not on origin/{branch}: push them first", REFUSE)
    removed = []
    for wt in [spec_wt] + [run.root / f"issue-{x['number']}" for x in plan["slices"]]:
        if wt.is_dir():
            remove_worktree(run, wt)
            removed.append(wt.name)
    git(run.repo_dir, "worktree", "prune")
    if run.notes.is_dir():
        shutil.rmtree(run.notes)
        removed.append("notes")
    spec_pr = spec_pr_of(run, run.base(), plan["spec_branch"])
    url = spec_pr["url"] if spec_pr else None
    run.status(step="review-pr", state="running",
               summary="cleaned up: " + (", ".join(removed) or "nothing left")
               + (f"; reviewing and fixing PR #{spec_pr['number']}" if spec_pr else ""),
               next="/review-fix-pr, then drive-spec finish done", branch=plan["spec_branch"],
               **({"pr_url": url} if url else {}))
    print("removed " + (", ".join(removed) or "nothing"))
    print(url or "no open spec PR")
    return 0


# operator questions

def one_line(text, width=160):
    text = " ".join(text.split())
    return text if len(text) <= width else text[:width - 1] + "…"


def cmd_ask(spec, question, blocking, step, ref=None):
    run = Run(spec)
    current = run.current()
    pending_ref = run.notes / "question-ref"
    if ref:
        known = {r for r, _ in questions(run)}
        unknown = [r for r in ref.split(",") if r.strip() not in known]
        if unknown:
            raise Failed(f"{', '.join(unknown)} is not in questions.md", REFUSE)
        run.notes.mkdir(parents=True, exist_ok=True)
        pending_ref.write_text(ref + "\n")
    else:
        pending_ref.unlink(missing_ok=True)
    step = step or current.get("step") or "resolve"
    if blocking:
        run.status(step=step, state="waiting", question=" ".join(question.split()), question_blocking="true",
                   summary=f"waiting for the operator: {one_line(question, 100)}", next="act on the operator's answer")
        print("asked: end the turn now; the answer arrives as the next prompt, then run `drive-spec answered`")
    else:
        run.status(step=step, question=" ".join(question.split()), question_blocking="false")
        print("noted for the operator; carry on")
    return 0


def cmd_answered(spec, answer):
    run = Run(spec)
    current = run.current()
    question = current.get("question")
    if not question:
        raise Failed(f"no question is open on #{spec}: ask one with `drive-spec ask`", REFUSE)
    answer = answer.strip()
    if not answer:
        raise Failed("an empty answer: pass the operator's words", REFUSE)
    gh(f"repos/{run.repo}/issues/{spec}/comments", "-f",
       f"body=Operator decision.\n\n> {question}\n\n{answer}", "--silent")
    run.notes.mkdir(parents=True, exist_ok=True)
    try:
        ref = (run.notes / "question-ref").read_text().strip()
    except OSError:
        ref = ""
    with open(run.notes / "decisions.md", "a") as f:
        f.write(f"- {f'[{ref}] ' if ref else ''}{question}\n  Answer: {" ".join(answer.split())}\n")
    (run.notes / "question-ref").unlink(missing_ok=True)
    step = current.get("step") or "resolve"
    run.status(step=step, state="running", question="", summary=f"operator answered: {one_line(answer, 120)}",
               next=f"carry on with {step}")
    print(f"recorded on #{spec} and in {run.notes / 'decisions.md'}; implementers read it from their brief")
    return 0


# resume

STEP_COMMANDS = {
    "guard": "drive-spec plan {spec}",
    "worktree": "drive-spec open {spec}",
    "preview": "drive-spec preview {spec}",
    "build": "drive-spec frontier {spec}",
    "review": "drive-spec review {spec}",
    "confirm": "drive-spec confirm {spec}",
    "cleanup": "drive-spec cleanup {spec}",
}


def next_step(run, status):
    """The command that carries a run on from its status file alone."""
    spec, step, state = run.spec, status.get("step"), status.get("state")
    if not status or not (run.notes / "run.json").is_file() and step not in ("review-pr", None):
        return "resolve", f"step 1: resolve the run, then `drive-spec gate {spec} '<verify>' --base <base>`"
    if state == "done":
        return step, "none: the run is done"
    if state == "waiting":
        return step, (f"the operator's answer to: {status.get('question')}; then "
                      f"`drive-spec answered {spec} '<their words>'`")
    if state in ("halted", "paused"):
        return step, f"{status.get('next')} (the run is {state}: {status.get('summary')})"
    if step == "explore":
        brief = run.notes / "brief-explore.md"
        return step, (f"`drive-spec explored {spec}` once the explorer has written its notes" if brief.is_file()
                      else f"`drive-spec explore {spec}`")
    if step == "review-pr":
        pr = (status.get("pr_url") or "").rsplit("/", 1)[-1]
        return step, f"`/review-fix-pr {pr}`, then `drive-spec finish {spec} done`"
    if step in STEP_COMMANDS:
        return step, f"`{STEP_COMMANDS[step].format(spec=spec)}`"
    return step or "resolve", f"`drive-spec gate {spec} '<verify>' --base <base>`"


def cmd_next(spec):
    run = Run(spec)
    step, command = next_step(run, run.current())
    print(f"step: {step}\nnext: {command}")
    return 0


# halt and finish

OUTCOMES = {"done": ("done", "review-pr"), "halted": ("halted", "build"), "conflicts": ("halted", "explore"),
            "ceiling": ("paused", "build"), "held": ("paused", "build"), "refused": ("halted", "guard")}


def finish(run, outcome, why=None, slice_=None, step=None, resume=None, left=None):
    spec = run.spec
    plan = make_plan(run)
    resume = resume or f"/drive-spec {spec}"
    extra = ""
    spec_pr = None
    if outcome == "refused":
        if not plan["refuse"]:
            raise Failed(f"`drive-spec plan {spec}` does not refuse the spec", REFUSE)
        first = f"drive-spec refused #{spec}: {plan['refuse']}."
    else:
        if plan["refuse"]:
            raise Failed(f"the plan refuses #{spec}: finish it as `refused`", REFUSE)
        slices = plan["slices"]
        landed = sum(s["state"] == "closed" for s in slices)
        if outcome == "done":
            open_ = [f"#{s['number']}" for s in slices if s["state"] != "closed"]
            if open_:
                raise Failed(f"not done: {', '.join(open_)} still open", REFUSE)
            spec_pr = spec_pr_of(run, run.base(), plan["spec_branch"]) if plan["spec_branch"] else None
            if not spec_pr:
                raise Failed("not done: no open spec PR", REFUSE)
            if left is None:
                left = left_of(json.loads(gh(f"repos/{run.repo}/pulls/{spec_pr['number']}", "--jq", "{body}"))["body"])
            review = "review left findings open" if left else "review clean"
            first = f"drive-spec done: all {len(slices)} slices landed, {review}. Spec PR #{spec_pr['number']}."
            if left:
                extra = "Left from review:\n" + left.strip()
        elif outcome == "halted":
            if not why:
                raise Failed("a halt needs --why", REFUSE)
            first = f"drive-spec halted on #{slice_}: {why}." if slice_ else f"drive-spec halted: {why}."
        elif outcome == "conflicts":
            try:
                extra = (run.notes / "conflicts.md").read_text().strip()
            except FileNotFoundError:
                extra = ""
            if not extra:
                raise Failed(f"no conflicts recorded in {run.notes / 'conflicts.md'}", REFUSE)
            first = "drive-spec halted before building: the spec and its slices disagree."
        elif outcome == "ceiling":
            first = f"drive-spec paused at maxSlices: {landed} of {len(slices)} slices landed."
        elif outcome == "held":
            held = [f"#{s['number']}" for s in slices if s["state"] == "held"]
            if not held:
                raise Failed("no held slices", REFUSE)
            first = f"drive-spec paused: only held slices remain ({', '.join(held)}). Resume in a local session."
    body = first + ("" if outcome == "done" else f"\n`{resume}`") + (f"\n\n{extra}" if extra else "")
    gh(f"repos/{run.repo}/issues/{spec}/comments", "-f", f"body={body}", "--silent")
    known = {}
    if outcome != "refused" and plan["spec_branch"]:
        base = run.base()
        spec_pr = spec_pr or spec_pr_of(run, base, plan["spec_branch"])
        post_progress(run, plan, base, spec_pr)
        known = {"branch": plan["spec_branch"], **({"pr_url": spec_pr["url"]} if spec_pr else {})}
    state, default_step = OUTCOMES[outcome]
    run.status(step=step or default_step, state=state, summary=first,
               next="none" if outcome == "done" else resume, question="", **known)
    print(body)
    return 0


def cmd_finish(spec, outcome, why, slice_, step, resume, left):
    if left and outcome != "done":
        raise Failed("--left goes with done only", REFUSE)
    return finish(Run(spec), outcome, why, slice_, step, resume, sys.stdin.read() if left == "-" else left)


def cmd_halt(spec, m, why):
    run = Run(spec)
    add_label(run, m, "agent:blocked")
    remove_label(run, m, "agent:in-progress")
    wt = run.root / f"issue-{m}"
    kept = f" Worktree kept at {wt}." if wt.is_dir() else ""
    gh(f"repos/{run.repo}/issues/{m}/comments", "--silent",
       "-f", f"body=drive-spec halted here: {why}.{kept} Resume with `/drive-spec {spec}` after fixing.")
    return finish(run, "halted", why, m)


def main():
    p = argparse.ArgumentParser(prog="drive-spec")
    sub = p.add_subparsers(dest="cmd", required=True)
    pl = sub.add_parser("plan", help="a spec's slices in build order, each with its state; exit 2 to refuse the spec")
    pl.add_argument("spec")
    pl.add_argument("--json", action="store_true")
    g = sub.add_parser("gate", help="print the run's verify gate, or pin one for the run")
    g.add_argument("spec")
    g.add_argument("command", nargs="?")
    g.add_argument("--base", help="with a command: the run's base branch; default config, then the repo's")
    v = sub.add_parser("verify", help="run the gate on a worktree's HEAD and record the verdict; exit 4 when red")
    v.add_argument("spec", help="the spec, or pr-<n> to verify a PR head outside a spec run")
    v.add_argument("worktree")
    v.add_argument("--gate", help="the gate to run; default the pinned gate, then `verify` in the config")
    v.add_argument("--wait-minutes", type=float, dest="wait",
                   help="return after this long, exit 6, while the gate runs on detached; run again to keep waiting")
    v.add_argument("--worker", action="store_true", help=argparse.SUPPRESS)
    i = sub.add_parser("integrate", help="merge the spec branch into a slice, verify, push, merge its PR")
    i.add_argument("spec")
    i.add_argument("slice")
    i.add_argument("--deviations", help="the implementer's Deviations list, `none`, or `-` for stdin")
    i.add_argument("--wait-minutes", type=float, dest="wait",
                   help="return after this long, exit 6, while a gate runs on; run again to pick up where it stopped")
    la = sub.add_parser("land", help="close a merged slice, remove its worktree and branch, open the spec PR")
    la.add_argument("spec")
    la.add_argument("slice")
    pr = sub.add_parser("progress", help="refresh the progress comment on the spec")
    pr.add_argument("spec")
    fr = sub.add_parser("frontier", help="the next slices to build, continue or integrate, or why the run stops")
    fr.add_argument("spec")
    fr.add_argument("--running", default="", help="slices whose implementer is running now, comma-separated")
    fr.add_argument("--sequential", action="store_true")
    fr.add_argument("--max", type=int, dest="max_slices", help="maxSlices; default from .claude/drive-spec.json")
    fr.add_argument("--json", action="store_true")
    st = sub.add_parser("start", help="open a frontier slice's worktree, label it, print the implementer brief")
    st.add_argument("spec")
    st.add_argument("slice")
    h = sub.add_parser("halt", help="halt the run on a red slice: label, comment, status comment, status")
    h.add_argument("spec")
    h.add_argument("slice")
    h.add_argument("why", nargs="+")
    op = sub.add_parser("open", help="open the spec worktree: resume the spec branch from origin, or cut and push it")
    op.add_argument("spec")
    op.add_argument("--base", help="base branch; default from the status file, config, or the repo")
    co = sub.add_parser("confirm", help="with every slice closed: the spec PR closes the spec and lists deviations")
    co.add_argument("spec")
    co.add_argument("--left", help="what the last review left open, or `-` for stdin")
    pv = sub.add_parser("preview", help="print the run, refresh the progress comment; --dry-run pauses there")
    pv.add_argument("spec")
    pv.add_argument("--sequential", action="store_true")
    pv.add_argument("--max", type=int, dest="max_slices", help="maxSlices; default from .claude/drive-spec.json")
    pv.add_argument("--dry-run", action="store_true")
    ex = sub.add_parser("explored", help="end of explore: notes for every open slice; exit 3 halts on conflicts")
    ex.add_argument("spec")
    nx = sub.add_parser("next", help="the command that carries the run on, from its status file")
    nx.add_argument("spec")
    rw = sub.add_parser("review", help="step 7: the next review round's brief, its fixer's brief, or clean")
    rw.add_argument("spec")
    rv = sub.add_parser("reviewed", help="end of review: a clean last round on the pushed, green spec branch")
    rv.add_argument("spec")
    rv.add_argument("--left", help="more for the left list, beyond the rounds' judgement calls; `-` for stdin")
    cl = sub.add_parser("cleanup", help="remove the spec and slice worktrees and the notes")
    cl.add_argument("spec")
    ak = sub.add_parser("ask", help="stop for the operator's decision (or note one, with --no-block)")
    ak.add_argument("spec")
    ak.add_argument("question", help="the question, with the options and your recommendation")
    ak.add_argument("--no-block", dest="blocking", action="store_false",
                    help="a judgement call made on your own the operator may revisit; the run goes on")
    ak.add_argument("--step", help="default: the step in the status file")
    ak.add_argument("--ref", help="the questions.md ids this question settles, comma-separated: Q1,Q2")
    xp = sub.add_parser("explore", help="write the explorer brief for step 5")
    xp.add_argument("spec")
    an = sub.add_parser("answered", help="record the operator's answer on the spec and for the implementers")
    an.add_argument("spec")
    an.add_argument("answer", help="the operator's own words, or `-` for stdin")
    fi = sub.add_parser("finish", help="post the run's status comment and final status")
    fi.add_argument("spec")
    fi.add_argument("outcome", choices=sorted(OUTCOMES))
    fi.add_argument("--why")
    fi.add_argument("--slice", type=lambda v: int(v.lstrip("#")))
    fi.add_argument("--step")
    fi.add_argument("--resume", help="resume command; default /drive-spec <spec>")
    fi.add_argument("--left", help="with done: what the last review left open, or `-` for stdin")
    args = p.parse_args()
    spec = args.spec if args.cmd == "verify" and re.fullmatch(r"pr-\d+", args.spec) else int(args.spec.lstrip("#"))
    try:
        if args.cmd == "plan":
            code = cmd_plan(spec, args.json)
        elif args.cmd == "gate":
            code = cmd_gate(spec, args.command, args.base)
        elif args.cmd == "verify":
            code = cmd_verify(spec, args.worktree, args.gate, args.wait, args.worker)
        elif args.cmd == "integrate":
            code = cmd_integrate(spec, int(args.slice.lstrip("#")), args.deviations, args.wait)
        elif args.cmd == "land":
            code = cmd_land(spec, int(args.slice.lstrip("#")))
        elif args.cmd == "progress":
            code = cmd_progress(spec)
        elif args.cmd == "open":
            code = cmd_open(spec, args.base)
        elif args.cmd == "confirm":
            code = cmd_confirm(spec, sys.stdin.read() if args.left == "-" else args.left)
        elif args.cmd == "cleanup":
            code = cmd_cleanup(spec)
        elif args.cmd == "ask":
            code = cmd_ask(spec, args.question, args.blocking, args.step, args.ref)
        elif args.cmd == "explore":
            code = cmd_explore(spec)
        elif args.cmd == "answered":
            code = cmd_answered(spec, sys.stdin.read() if args.answer == "-" else args.answer)
        elif args.cmd == "preview":
            code = cmd_preview(spec, args.sequential, args.max_slices, args.dry_run)
        elif args.cmd == "explored":
            code = cmd_explored(spec)
        elif args.cmd == "next":
            code = cmd_next(spec)
        elif args.cmd == "review":
            code = cmd_review(spec)
        elif args.cmd == "reviewed":
            code = cmd_reviewed(spec, sys.stdin.read() if args.left == "-" else args.left)
        elif args.cmd == "frontier":
            running = [int(x.strip().lstrip("#")) for x in args.running.split(",") if x.strip()]
            code = cmd_frontier(spec, running, args.sequential, args.max_slices, args.json)
        elif args.cmd == "start":
            code = cmd_start(spec, int(args.slice.lstrip("#")))
        elif args.cmd == "halt":
            code = cmd_halt(spec, int(args.slice.lstrip("#")), " ".join(args.why).rstrip("."))
        elif args.cmd == "finish":
            code = cmd_finish(spec, args.outcome, args.why and args.why.rstrip("."), args.slice, args.step,
                              args.resume, args.left)
    except Failed as e:
        print(f"drive-spec: {e}", file=sys.stderr)
        code = e.code
    sys.exit(code)


if __name__ == "__main__":
    main()
